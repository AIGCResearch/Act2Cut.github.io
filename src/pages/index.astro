---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import HeroSection from '../components/HeroSection.astro';
import AbstractSection from '../components/AbstractSection.astro';
import OverviewSection from '../components/OverviewSection.astro';
import DataCollectionCard from '../components/DataCollectionCard.astro';
import CitationSection from '../components/CitationSection.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Layout title="Act2Cut: Continuous Multi-Shot Video Narrative Match on Action-Cut">
  <Navigation page="home" />
  <main class="w-full max-w-5xl mx-auto px-4 sm:px-6 pt-8 pb-16 md:pb-24 flex flex-col gap-16 relative z-10">
    <HeroSection />
    <AbstractSection />
    <OverviewSection />

    <!-- Data Collection & Processing -->
    <DataCollectionCard />

    <!-- Performance Comparison teaser (mini table) -->
    <div data-reveal>
      <div class="text-center mb-6 sm:mb-8">
        <span class="text-[10px] font-bold tracking-[0.32em] uppercase text-white/40 block mb-2">Quantitative Snapshot</span>
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">Performance Comparison</h2>
      </div>

      <!-- Glass card with native HTML table -->
      <div class="glass-table-card relative rounded-2xl sm:rounded-3xl border border-white/[0.10] shadow-2xl overflow-hidden">
        <!-- Top sheen -->
        <div
          class="absolute inset-x-0 top-0 h-px pointer-events-none"
          style="background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent);"
        ></div>

        <!-- Card header: title + dataset pill -->
        <div class="flex items-start justify-between gap-3 flex-wrap px-5 sm:px-7 pt-5 sm:pt-6 pb-4 border-b border-white/[0.06]">
          <div class="space-y-1.5">
            <h3 class="text-[13px] sm:text-sm font-semibold text-white/90 tracking-wide">
              Quantitative Results — ActCutBench (Global Content Sub-Bench)
            </h3>
            <p class="text-[10.5px] sm:text-[11px] text-white/45 leading-relaxed max-w-3xl">
              Baseline and Ablation. <strong class="text-white/65 font-semibold">NC</strong> Narrative Consistency · <strong class="text-white/65 font-semibold">VC</strong> Visual Coherence · <strong class="text-white/65 font-semibold">AC</strong> Action Continuity · <strong class="text-white/65 font-semibold">SC</strong> Subject Correctness · <strong class="text-white/65 font-semibold">Aes</strong> Aesthetics. <span class="text-[#ffb84d]">★</span> = Act2Cut (Ours).
            </p>
            <div class="flex items-center gap-1.5 pt-1 text-[9.5px] text-white/40">
              <span class="rank-cell rank-1 text-[9.5px]" style="min-width:0;padding:1px 5px;">1st</span>
              <span class="rank-cell rank-2 text-[9.5px]" style="min-width:0;padding:1px 5px;">2nd</span>
              <span class="rank-cell rank-3 text-[9.5px]" style="min-width:0;padding:1px 5px;">3rd</span>
              <span class="rank-cell rank-4 text-[9.5px]" style="min-width:0;padding:1px 5px;">4th</span>
              <span class="rank-cell rank-5 text-[9.5px]" style="min-width:0;padding:1px 5px;">5th</span>
            </div>
          </div>
          <span class="px-2.5 py-1 rounded-md text-[8.5px] sm:text-[9px] font-bold tracking-[0.22em] uppercase text-white/55 bg-white/[0.04] border border-white/[0.08] whitespace-nowrap">
            Dataset · ActCutVid-200K
          </span>
        </div>

        <!-- Table (compact summary; full per-dimension table lives on the benchmark page) -->
        <div class="overflow-x-auto thin-scroll">
          <table class="w-full text-left border-collapse text-[12px] whitespace-nowrap">
            <thead>
              <tr class="text-white/40 border-b border-white/10">
                <th class="px-4 sm:px-5 py-3 font-normal text-left" rowspan="2">Method</th>
                <th class="px-2 py-2 text-center text-[9px] tracking-widest text-[#ffb84d]/80 border-b border-[#ffb84d]/20 bg-[#ff4d4d]/5" colspan="2">NC ↑</th>
                <th class="px-2 py-2 text-center text-[9px] tracking-widest text-[#ffb84d]/80 border-b border-[#ffb84d]/20 bg-[#ff4d4d]/5" colspan="2">VC ↑</th>
                <th class="px-2 py-2 text-center text-[9px] tracking-widest text-[#ffb84d]/80 border-b border-[#ffb84d]/20 bg-[#ff4d4d]/5" colspan="1">AC ↑</th>
                <th class="px-2 py-2 text-center text-[9px] tracking-widest text-[#ffb84d]/80 border-b border-[#ffb84d]/20 bg-[#ff4d4d]/5" colspan="2">SC ↑</th>
                <th class="px-3 py-3 text-center font-normal" rowspan="2">Aes ↑</th>
              </tr>
              <tr class="text-white/30 border-b border-white/10 text-center">
                <th class="px-2.5 py-2 font-normal">G1</th><th class="px-2.5 py-2 font-normal">G2</th>
                <th class="px-2.5 py-2 font-normal">G1</th><th class="px-2.5 py-2 font-normal">CS</th>
                <th class="px-2.5 py-2 font-normal">CA/OM</th>
                <th class="px-2.5 py-2 font-normal">CC</th><th class="px-2.5 py-2 font-normal">CID</th>
              </tr>
            </thead>
            <tbody class="text-white/60 font-mono">
              <!-- ActCutBench · Open-Source Method -->
              <tr class="bg-white/[0.03] border-b border-white/[0.05]">
                <td class="px-4 sm:px-5 py-2 text-[9px] tracking-widest text-white/35 uppercase font-semibold italic" colspan="8">ActCutBench · Open-Source Method</td>
              </tr>
              <tr class="border-b border-white/[0.05] hover:bg-white/[0.04] transition-colors">
                <td class="px-4 sm:px-5 py-2.5 font-sans">HoloCine-14B</td>
                <td class="px-2.5 py-2.5 text-center"><span class="rank-cell rank-5">0.000</span></td>
                {Array(6).fill(null).map(() => <td class="px-2.5 py-2.5 text-center">0.000</td>)}
                <td class="px-3 py-2.5 text-center">0.000</td>
              </tr>
              <tr class="border-b border-white/[0.05] hover:bg-white/[0.04] transition-colors">
                <td class="px-4 sm:px-5 py-2.5 font-sans">MSM-1.3B</td>
                <td class="px-2.5 py-2.5 text-center"><span class="rank-cell rank-4">0.000</span></td>
                {Array(6).fill(null).map(() => <td class="px-2.5 py-2.5 text-center">0.000</td>)}
                <td class="px-3 py-2.5 text-center">0.000</td>
              </tr>
              <tr class="border-b border-white/[0.05] hover:bg-white/[0.04] transition-colors">
                <td class="px-4 sm:px-5 py-2.5 font-sans">MSM-14B</td>
                <td class="px-2.5 py-2.5 text-center"><span class="rank-cell rank-3">0.000</span></td>
                {Array(6).fill(null).map(() => <td class="px-2.5 py-2.5 text-center">0.000</td>)}
                <td class="px-3 py-2.5 text-center">0.000</td>
              </tr>
              <tr class="border-b border-white/[0.05] bg-[#ff4d4d]/[0.08] hover:bg-[#ff4d4d]/[0.12] transition-colors">
                <td class="px-4 sm:px-5 py-2.5 font-sans font-bold text-white border-l-2 border-[#ff4d4d]">★ Act2Cut <span class="text-white/55 font-medium">(Ours)</span></td>
                <td class="px-2.5 py-2.5 text-center"><span class="rank-cell rank-1">0.000</span></td>
                {Array(6).fill(null).map(() => <td class="px-2.5 py-2.5 text-center text-[#ffb84d]">0.000</td>)}
                <td class="px-3 py-2.5 text-center text-[#ffb84d]">0.000</td>
              </tr>

              <!-- ActCutBench-Lite · Ablation -->
              <tr class="bg-white/[0.03] border-y border-white/[0.05]">
                <td class="px-4 sm:px-5 py-2 text-[9px] tracking-widest text-white/35 uppercase font-semibold italic" colspan="8">ActCutBench-Lite · Ablation</td>
              </tr>
              <tr class="border-b border-white/[0.05] bg-[#ff4d4d]/[0.08] hover:bg-[#ff4d4d]/[0.12] transition-colors">
                <td class="px-4 sm:px-5 py-2.5 font-sans font-bold text-white border-l-2 border-[#ff4d4d]">★ Act2Cut (full)</td>
                <td class="px-2.5 py-2.5 text-center"><span class="rank-cell rank-1">0.000</span></td>
                {Array(6).fill(null).map(() => <td class="px-2.5 py-2.5 text-center text-[#ffb84d]">0.000</td>)}
                <td class="px-3 py-2.5 text-center text-[#ffb84d]">0.000</td>
              </tr>
              <tr class="border-b border-white/[0.05] hover:bg-white/[0.04] transition-colors">
                <td class="px-4 sm:px-5 py-2.5 font-sans text-white/75">Act2Cut (w/o GLoS)</td>
                {Array(7).fill(null).map(() => <td class="px-2.5 py-2.5 text-center">0.000</td>)}
                <td class="px-3 py-2.5 text-center">0.000</td>
              </tr>
              <tr class="border-b border-white/[0.05] hover:bg-white/[0.04] transition-colors">
                <td class="px-4 sm:px-5 py-2.5 font-sans text-white/75">Act2Cut (w/o TBR)</td>
                {Array(7).fill(null).map(() => <td class="px-2.5 py-2.5 text-center">0.000</td>)}
                <td class="px-3 py-2.5 text-center">0.000</td>
              </tr>
              <tr class="border-b border-white/[0.05] hover:bg-white/[0.04] transition-colors">
                <td class="px-4 sm:px-5 py-2.5 font-sans text-white/75">Act2Cut (w/o SCM)</td>
                {Array(7).fill(null).map(() => <td class="px-2.5 py-2.5 text-center">0.000</td>)}
                <td class="px-3 py-2.5 text-center">0.000</td>
              </tr>
              <tr class="border-b border-white/[0.05] hover:bg-white/[0.04] transition-colors">
                <td class="px-4 sm:px-5 py-2.5 font-sans text-white/75">Act2Cut (w/o HCM)</td>
                {Array(7).fill(null).map(() => <td class="px-2.5 py-2.5 text-center">0.000</td>)}
                <td class="px-3 py-2.5 text-center">0.000</td>
              </tr>

              <!-- Closed-Source Method -->
              <tr class="bg-white/[0.04] border-y border-white/[0.05]">
                <td class="px-4 sm:px-5 py-2 text-[9px] tracking-widest text-white/35 uppercase font-semibold italic" colspan="8">Closed-Source Method</td>
              </tr>
              <tr class="border-b border-white/[0.05] hover:bg-white/[0.04] transition-colors">
                <td class="px-4 sm:px-5 py-2.5 font-sans">Happyhorse-1.0</td>
                <td class="px-2.5 py-2.5 text-center"><span class="rank-cell rank-4">0.000</span></td>
                {Array(6).fill(null).map(() => <td class="px-2.5 py-2.5 text-center">0.000</td>)}
                <td class="px-3 py-2.5 text-center">0.000</td>
              </tr>
              <tr class="border-b border-white/[0.05] hover:bg-white/[0.04] transition-colors">
                <td class="px-4 sm:px-5 py-2.5 font-sans">Seedance-2.0</td>
                <td class="px-2.5 py-2.5 text-center"><span class="rank-cell rank-2">0.000</span></td>
                {Array(6).fill(null).map(() => <td class="px-2.5 py-2.5 text-center">0.000</td>)}
                <td class="px-3 py-2.5 text-center">0.000</td>
              </tr>
              <tr class="border-b border-white/[0.05] hover:bg-white/[0.04] transition-colors">
                <td class="px-4 sm:px-5 py-2.5 font-sans">Kling3</td>
                <td class="px-2.5 py-2.5 text-center"><span class="rank-cell rank-1">0.000</span></td>
                {Array(6).fill(null).map(() => <td class="px-2.5 py-2.5 text-center">0.000</td>)}
                <td class="px-3 py-2.5 text-center">0.000</td>
              </tr>
              <tr class="hover:bg-white/[0.04] transition-colors">
                <td class="px-4 sm:px-5 py-2.5 font-sans">Sora2</td>
                <td class="px-2.5 py-2.5 text-center"><span class="rank-cell rank-4">0.000</span></td>
                {Array(6).fill(null).map(() => <td class="px-2.5 py-2.5 text-center">0.000</td>)}
                <td class="px-3 py-2.5 text-center">0.000</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Card footer / link -->
        <div class="px-5 sm:px-7 py-3.5 border-t border-white/[0.06] flex items-center justify-between gap-3">
          <p class="text-[11px] text-white/35 leading-snug">
            Numbers are placeholder values for layout demonstration.
          </p>
          <a href={`${base}/benchmark`} class="shrink-0 inline-flex items-center gap-1.5 text-[10px] font-bold tracking-[0.22em] uppercase text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d] hover:opacity-80 transition-opacity">
            Full benchmarks
            <svg class="w-3 h-3 text-[#ffb84d]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>

    <CitationSection />
  </main>
</Layout>
