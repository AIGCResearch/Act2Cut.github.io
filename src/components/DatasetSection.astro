---
const pipelineSteps = [
  { n: '1', title: 'Source Collection',       desc: 'Large-scale video corpus from diverse genres, styles, and cinematographic traditions' },
  { n: '2', title: 'AC Detection',            desc: 'SCBO algorithm identifies action-cut boundaries with boundary-residual optimization' },
  { n: '3', title: 'Shot Segmentation',       desc: 'Audio-video segmentation into shot-level clips with precise boundary frame extraction' },
  { n: '4', title: 'Hierarchical Annotation', desc: 'Global scene + character captions; local static/dynamic cinematography; shot-relation labels' },
  { n: '5', title: 'Quality Filtering',       desc: 'LLM-based annotation verification and expert review to ensure label accuracy and clip quality' },
];

const statGroups = [
  {
    title: 'By Visual Style',
    bars: [
      { label: 'Live Action / Realistic',    w: 0.72 },
      { label: '2D Animation / Anime',       w: 0.55 },
      { label: '3D CGI',                     w: 0.38 },
      { label: 'Documentary / Non-Fiction',  w: 0.22 },
      { label: 'Other / Mixed',              w: 0.12 },
    ]
  },
  {
    title: 'By Shot Count per Sequence',
    bars: [
      { label: '2-Shot',  w: 0.65 },
      { label: '3-Shot',  w: 0.82 },
      { label: '4-Shot',  w: 0.45 },
      { label: '5-Shot',  w: 0.28 },
      { label: '6+ Shot', w: 0.15 },
    ]
  },
  {
    title: 'By Action Complexity',
    bars: [
      { label: 'Simple (Single action)',       w: 0.58 },
      { label: 'Medium (Action sequence)',     w: 0.75 },
      { label: 'Complex (Coordinated motion)', w: 0.42 },
      { label: 'Out-of-Domain (OOD)',           w: 0.18 },
    ],
  },
  {
    title: 'By Character Count',
    bars: [
      { label: 'Single-Character',           w: 0.62 },
      { label: 'Two-Character',              w: 0.48 },
      { label: 'Multi-Character (3+)',       w: 0.35 },
      { label: 'Background Crowd',           w: 0.20 },
    ],
  },
];

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

// Real sample clips from /public/sample_data — filenames encode movie + adjacent shot indices,
// e.g. "Batman_Begins__shot_clip-0314_0315.mp4" → "Batman Begins" · Shot 314 → 315.
const sampleFiles = [
  'Batman_Begins__shot_clip-0314_0315.mp4',
  'Big_Fish__shot_clip-0863_0864.mp4',
  'Blade_Runner_1__shot_clip-0542_0543.mp4',
  'Monsters_Inc__shot_clip-0694_0695.mp4',
  'My_Neighbor_Totoro__shot_clip-0262_0263.mp4',
  'Pirates_of_the_Caribbean_The_Curseof_the_Black_Pearl__shot_clip-0435_0436.mp4',
  'Princess_Mononoke__shot_clip-0353_0354.mp4',
  'Star_Trek__shot_clip-1535_1536.mp4',
  'Terminator__shot_clip-0628_0629.mp4',
  'The_Godfather_Part_II__shot_clip-0134_0135.mp4',
  'The_Shawshank_Redemption__shot_clip-0862_0863.mp4',
  'Weathering_with_You__shot_clip-1220_1221.mp4',
];

// Override or shorten the auto-derived movie title where the filename is awkward (typos, length).
const movieAliases: Record<string, string> = {
  'Blade Runner 1': 'Blade Runner',
  'Pirates of the Caribbean The Curseof the Black Pearl': 'Pirates of the Caribbean',
};

const styleByMovie: Record<string, string> = {
  'Batman Begins': 'Live Action',
  'Big Fish': 'Live Action',
  'Blade Runner': 'Live Action',
  'Monsters Inc': '3D CGI',
  'My Neighbor Totoro': '2D Anime',
  'Pirates of the Caribbean': 'Live Action',
  'Princess Mononoke': '2D Anime',
  'Star Trek': 'Live Action',
  'Terminator': 'Live Action',
  'The Godfather Part II': 'Live Action',
  'The Shawshank Redemption': 'Live Action',
  'Weathering with You': '2D Anime',
};

const samples = sampleFiles.map(file => {
  const m = file.match(/^(.+?)__shot_clip-(\d+)_(\d+)\.mp4$/);
  const rawMovie = (m ? m[1] : file).replace(/_/g, ' ').trim();
  const movie = movieAliases[rawMovie] ?? rawMovie;
  const a = m ? parseInt(m[2], 10) : 0;
  const b = m ? parseInt(m[3], 10) : 0;
  return {
    file,
    movie,
    style: styleByMovie[movie] ?? '—',
    shots: m ? `Shot ${a} → ${b}` : '',
    src: `${base}/sample_data/${file}`,
  };
});
---

<section id="dataset" class="space-y-10 sm:space-y-12">

  <!-- Section header -->
  <div data-reveal>
    <span class="act-marker">ACT Ⅲ</span>
    <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight flex items-center gap-3 mt-1">
      <span class="inline-block w-1 h-6 sm:h-7 bg-gradient-to-b from-[#ff4d4d] to-[#ffb84d] rounded-sm" style="transform: skewX(-6deg);"></span>
      Large-Scale Dataset: ActCutVid-200k
    </h2>
    <p class="text-white/50 text-[13px] sm:text-sm mt-2">Large-scale multi-shot video corpus with hierarchical cinematographic annotation.</p>
  </div>

  <!-- Construction pipeline -->
  <div data-reveal style="transition-delay:100ms">
    <h3 class="text-lg sm:text-xl font-semibold mb-6 sm:mb-8 text-white/80">Construction Pipeline</h3>
    <div class="relative flex items-start gap-0 overflow-x-auto thin-scroll pb-2 -mx-4 px-4 sm:mx-0 sm:px-0 scroll-smooth snap-x">
      <div class="absolute top-6 left-8 right-8 h-px bg-gradient-to-r from-[#ff4d4d]/30 to-[#ffb84d]/30 pointer-events-none"></div>
      {pipelineSteps.map((step) => (
        <div class="flex-1 min-w-[150px] px-3 sm:px-4 flex flex-col items-center text-center relative z-10 snap-start">
          <div class="w-12 h-12 rounded-full border border-[#ff4d4d]/40 bg-black flex items-center justify-center mb-4 sm:mb-5 hover:border-[#ff4d4d] transition-colors">
            <span class="text-sm font-bold text-[#ffb84d]">{step.n}</span>
          </div>
          <div class="text-[13px] sm:text-sm font-semibold text-white mb-1.5 sm:mb-2">{step.title}</div>
          <div class="text-[11px] sm:text-xs text-white/50 leading-relaxed">{step.desc}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="film-strip-divider"></div>

  <!-- Statistics bars -->
  <div>
    <h3 class="text-lg sm:text-xl font-semibold mb-6 sm:mb-8 text-white/80" data-reveal>Statistics</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-5 sm:gap-x-6 gap-y-5">
      {statGroups.map((group, gi) => (
        <div
          class="rounded-2xl border border-white/[0.08] bg-white/[0.02] backdrop-blur-xl p-5 md:p-6 hover:border-white/[0.14] hover:bg-white/[0.035] transition-all duration-300"
          data-reveal
          style={`transition-delay:${gi * 100}ms`}
        >
          <div class="text-[13px] font-semibold text-white mb-5 pb-3 border-b border-white/10 tracking-wide">{group.title}</div>
          {group.bars.map(bar => (
            <div class="mb-3.5 last:mb-0">
              <div class="flex justify-between items-baseline mb-1.5 gap-2">
                <span class="text-[12px] text-white/60 leading-tight">{bar.label}</span>
                <span class="text-[10px] font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d] shrink-0">—%</span>
              </div>
              <div class="h-0.5 bg-white/[0.07] rounded overflow-hidden">
                <div class="stat-bar-fill" style={`--fill-w:${bar.w};`}></div>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>

  <div class="film-strip-divider"></div>

  <!-- Sample data grid -->
  <div>
    <div class="flex items-baseline justify-between gap-3 mb-6 sm:mb-8" data-reveal>
      <h3 class="text-lg sm:text-xl font-semibold text-white/80">Sample Data</h3>
      <span class="text-[10px] sm:text-[11px] text-white/35">{samples.length} clips · adjacent action-cut pairs</span>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
      {samples.map((s, i) => (
        <div
          class="sample-card group relative rounded-xl bg-white/[0.03] border border-white/[0.07] overflow-hidden hover:border-[#ff4d4d]/40 hover:bg-white/[0.05]"
          data-reveal
          style={`transition-delay:${i * 50}ms`}
        >
          <div class="cinema-aspect bg-black/55 border-b border-white/[0.07] relative overflow-hidden">
            <video
              src={s.src}
              class="sample-video absolute inset-0 w-full h-full object-cover"
              muted loop playsinline preload="metadata"
            ></video>
            <span class="absolute top-2 left-2 z-10 px-1.5 py-0.5 rounded font-mono text-[8px] font-bold tracking-[0.10em] text-white/85 bg-black/55 border border-white/15 backdrop-blur-sm">
              {s.shots}
            </span>
            <div class="qg-scrub" data-scrub>
              <div class="qg-scrub-fill"></div>
              <div class="qg-scrub-thumb"></div>
            </div>
          </div>
          <div class="p-2.5 sm:p-3">
            <div class="text-[10.5px] sm:text-[11px] text-white font-semibold leading-tight truncate" title={s.movie}>{s.movie}</div>
            <div class="text-[9.5px] sm:text-[10px] text-white/40 mt-1 leading-snug">{s.style}</div>
          </div>
        </div>
      ))}
    </div>
  </div>

</section>

<script>
  // Hover-to-play + custom progress scrubber for the Sample Data grid.
  const samples = document.querySelectorAll<HTMLElement>('.sample-card');
  const isTouch = window.matchMedia('(hover: none)').matches;

  samples.forEach(card => {
    const video = card.querySelector<HTMLVideoElement>('video.sample-video');
    if (!video) return;

    if (!isTouch) {
      card.addEventListener('mouseenter', () => {
        if (!(video as any)._scrubbing) video.play().catch(() => {});
      });
      card.addEventListener('mouseleave', () => {
        if (!(video as any)._scrubbing) video.pause();
      });
    }

    const scrub = card.querySelector<HTMLElement>('[data-scrub]');
    if (!scrub) return;
    const fill  = scrub.querySelector<HTMLElement>('.qg-scrub-fill');
    const thumb = scrub.querySelector<HTMLElement>('.qg-scrub-thumb');
    if (!fill || !thumb) return;

    const update = () => {
      const d = video.duration;
      if (!d || !isFinite(d)) return;
      const pct = (video.currentTime / d) * 100;
      fill.style.width = pct + '%';
      thumb.style.left = pct + '%';
    };
    video.addEventListener('timeupdate', update);
    video.addEventListener('loadedmetadata', update);

    const seek = (clientX: number) => {
      const r = scrub.getBoundingClientRect();
      if (r.width <= 0) return;
      let p = (clientX - r.left) / r.width;
      p = Math.min(1, Math.max(0, p));
      if (video.duration && isFinite(video.duration)) {
        video.currentTime = p * video.duration;
        update();
      }
    };

    let dragging = false, wasPlaying = false;
    scrub.addEventListener('pointerdown', (e: PointerEvent) => {
      e.preventDefault();
      dragging = true;
      (video as any)._scrubbing = true;
      wasPlaying = !video.paused;
      video.pause();
      scrub.classList.add('is-dragging');
      scrub.setPointerCapture(e.pointerId);
      seek(e.clientX);
    });
    scrub.addEventListener('pointermove', (e: PointerEvent) => {
      if (dragging) seek(e.clientX);
    });
    const end = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      (video as any)._scrubbing = false;
      scrub.classList.remove('is-dragging');
      try { scrub.releasePointerCapture(e.pointerId); } catch {}
      if (wasPlaying) video.play().catch(() => {});
    };
    scrub.addEventListener('pointerup', end);
    scrub.addEventListener('pointercancel', end);
  });

  // Touch: autoplay visible sample videos via IntersectionObserver
  if (isTouch) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) v.play().catch(() => {});
        else v.pause();
      });
    }, { threshold: 0.4 });
    document.querySelectorAll<HTMLVideoElement>('.sample-video').forEach(v => io.observe(v));
  }
</script>
