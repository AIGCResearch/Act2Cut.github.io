---
import DualVideo from './DualVideo.astro';

const pipelineSteps = [
  { title: 'Source Collection', points: ['Video sequences come from films, television series, anime, variety shows, short-form dramas, and AI-generated content.'] },
  { title: 'Shot Segmentation', points: ['TransNetV2 detects initial shot boundaries.', 'SCBO uses CLIP/DINO features to refine them.'] },
  { title: 'Continuous Action Detection', points: ['Gemini-3-Pro scores action continuity on a 0–4 Likert scale by assessing action state consistency and motion flow continuity across adjacent shots.', 'A score of 4 indicates Strong Action-Cut; scores of 1–3 indicate Weak Action-Cut.'] },
  { title: 'Hierarchical Annotations', points: ['Annotations separate global setting, global action, local cinematography, Focus of Attention (FoA), and shot transitions.'] },
  { title: 'Human-in-the-Loop Check', points: ['LLMs verify annotations.', 'Experts review action continuity, annotation accuracy, and clip quality.'] },
];

const statGroups = [
  {
    title: 'By Visual Style',
    bars: [
      { label: 'Live Action / Realistic',    pct: 47.3 },
      { label: '2D Animation / Anime',       pct: 33.6 },
      { label: '3D CGI',                     pct: 19.1 },
    ]
  },
  {
    title: 'By Shot Count per Sequence',
    bars: [
      { label: '2-Shot',  pct: 33.1 },
      { label: '3-Shot',  pct: 38.2 },
      { label: '4-Shot',  pct:  15.9 },
      { label: '5-Shot',  pct:  11.4 },
      { label: '6+ Shot', pct:  1.4 },
    ]
  },
  {
    title: 'By Action Complexity',
    bars: [
      { label: 'Few + Simple',   pct: 32.7 },
      { label: 'Few + Complex',  pct: 56.2 },
      { label: 'Many + Complex', pct:  2.3 },
      { label: 'Many + Simple',  pct:  8.7 },
    ],
  },
  {
    title: 'By Character Count',
    bars: [
      { label: 'Single-Character',       pct: 32.0 },
      { label: 'Two-Character',          pct: 40.5 },
      { label: 'Multi-Character (3+)',   pct: 21.5 },
      { label: 'Background Crowd',       pct:  6.0 },
    ],
  },
];

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

// Real sample clips from /public/sample_data
// Filename format: NN_MovieName_group_XXXX_shot_YYYY_ZZZZ.mp4
const sampleFiles = [
  '02_Harry_Potter_The_Chamber_of_Secrets_group_0033_shot_0246_0253.mp4',
  '04_Batman_Begins_group_0062_shot_0750_0756.mp4',
  '05_Suzume_group_0107_shot_0780_0786.mp4',
  '08_Toy_Story_group_0193_shot_1445_1450.mp4',
  '09_Up_group_0161_shot_1264_1268.mp4',
  '11_Avatar_group_0138_shot_0886_0892.mp4',
  '15_Harry_Potter_The_Chamber_of_Secrets_group_0048_shot_0406_0412.mp4',
  '16_Suzume_group_0171_shot_1230_1236.mp4',
  '17_Weathering_with_You_group_0004_shot_0031_0033.mp4',
  '18_Spirited_Away_group_0136_shot_1198_1200.mp4',
  '19_Your_Name_group_0081_shot_1243_1246.mp4',
  '20_WALL-E_group_0030_shot_0331_0333.mp4',
];

const styleByMovie: Record<string, string> = {
  'Avatar': 'Live Action',
  'Harry Potter The Chamber of Secrets': 'Live Action',
  'Batman Begins': 'Live Action',
  'Suzume': '2D Anime',
  'Weathering with You': '2D Anime',
  'Toy Story': '3D CGI',
  'Up': '3D CGI',
  'Your Name': '2D Anime',
  'Spirited Away': '2D Anime',
  'WALL-E': '3D CGI',
};

const samples = sampleFiles.map(file => {
  // NN_MovieName_group_XXXX_shot_YYYY_ZZZZ.mp4
  const m = file.match(/^\d+_(.+?)_group_\d+_shot_(\d+)_(\d+)\.mp4$/);
  const movie = m ? m[1].replace(/_/g, ' ') : file;
  const a = m ? parseInt(m[2], 10) : 0;
  const b = m ? parseInt(m[3], 10) : 0;
  return {
    file,
    movie,
    style: styleByMovie[movie] ?? 'Live Action',
    shots: m ? `Shot ${a} → ${b}` : '',
    src: `${base}/sample_data/${file}`,
  };
});
---

<section id="dataset" class="space-y-10 sm:space-y-12">

  <!-- Section header -->
  <div data-reveal class="ambient-scrim">
    <div class="hero-content-divider mb-2" aria-hidden="true"></div>
    <span class="act-marker">Section 2</span>
    <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight flex items-center gap-3 mt-1 section-heading-float">
      <span class="inline-block w-1 h-6 sm:h-7 bg-gradient-to-b from-[#ff4d4d] to-[#ffb84d] rounded-sm" style="transform: skewX(-6deg);"></span>
      Large-Scale Dataset: ActCutVid-1M
    </h2>
    <p class="text-white/50 text-sm sm:text-base mt-2 section-heading-float">Large-scale multi-shot video sequence with hierarchical cinematographic annotation.</p>
  </div>

  <!-- Construction pipeline -->
  <div data-reveal style="transition-delay:100ms">
    <h3 class="text-lg sm:text-xl font-semibold mb-5 sm:mb-6 text-white/80 section-heading-float">Construction Pipeline</h3>
    <div class="glass-card rounded-2xl border border-white/[0.08] px-4 sm:px-6 py-6">
      <div class="relative">
        <div class="hidden lg:block absolute top-6 left-[10%] right-[10%] h-px bg-gradient-to-r from-[#ff4d4d]/30 to-[#ffb84d]/30 pointer-events-none" aria-hidden="true"></div>
        <ol class="relative grid gap-5 lg:grid-cols-5 lg:gap-0">
          {pipelineSteps.map((step, index) => (
            <li class="flex items-start gap-3 lg:flex-col lg:items-center lg:gap-4 lg:px-3 lg:text-center">
              <div class="w-12 h-12 shrink-0 rounded-full border border-[#ff4d4d]/40 bg-white/[0.04] flex items-center justify-center hover:border-[#ff4d4d] transition-colors">
                <span class="text-sm font-bold text-[#ffb84d]">{index + 1}</span>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-white mb-1.5">{step.title}</h4>
                <ul class="space-y-1 text-left text-[13px] text-white/70 leading-relaxed">
                  {step.points.map(point => (
                    <li class="flex items-start gap-2">
                      <span class="mt-[0.42rem] w-2 h-2 rounded-full shrink-0 bg-[#ffb84d] text-[#ffb84d] shadow-[0_0_10px_currentColor]" aria-hidden="true"></span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>

  <div class="film-strip-divider"></div>

  <!-- Statistics bars -->
  <div>
    <h3 class="text-lg sm:text-xl font-semibold mb-6 sm:mb-8 text-white/80 section-heading-float" data-reveal>Statistics</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4 gap-x-5 sm:gap-x-6 gap-y-5">
      {statGroups.map((group, gi) => (
        <div
          class="glass-card rounded-2xl border border-white/[0.08] p-5 md:p-6 hover:border-white/[0.16] transition-all duration-300"
          data-reveal
          style={`transition-delay:${gi * 100}ms`}
        >
          <div class="text-[13px] font-semibold text-white mb-5 pb-3 border-b border-white/10 tracking-wide">{group.title}</div>
          {(() => {
            const maxPct = Math.max(...group.bars.map(b => b.pct), 1);
            return group.bars.map(bar => (
              <div class="mb-3.5 last:mb-0">
                <div class="flex justify-between items-baseline mb-1.5 gap-2">
                  <span class="text-[12px] text-white/60 leading-tight">{bar.label}</span>
                  <span class="text-[10px] font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d] shrink-0">{bar.pct.toFixed(1)}%</span>
                </div>
                <div class="h-0.5 bg-white/[0.07] rounded overflow-hidden">
                  <div class="stat-bar-fill" style={`--fill-w:${bar.pct / maxPct};`}></div>
                </div>
              </div>
            ));
          })()}
        </div>
      ))}
    </div>
  </div>

  <div class="film-strip-divider"></div>

  <!-- Sample data grid -->
  <div>
    <div class="flex items-baseline justify-between gap-3 mb-6 sm:mb-8" data-reveal>
      <h3 class="text-lg sm:text-xl font-semibold text-white/80 section-heading-float">Sample Data</h3>
      <span class="text-[10px] sm:text-[11px] text-white/35">{samples.length} clips · adjacent action-cut pairs</span>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
      {samples.map((s, i) => (
        <div
          class="sample-card group relative glass-card rounded-xl border border-white/[0.08] overflow-hidden hover:border-[#ff4d4d]/40"
          data-reveal
          style={`transition-delay:${i * 50}ms`}
        >
          <div class="cinema-aspect bg-black/55 border-b border-white/[0.07] relative overflow-hidden">
            <DualVideo src={s.src} class="sample-video absolute inset-0 w-full h-full object-contain" />
            <span class="absolute top-2 left-2 z-10 px-1.5 py-0.5 rounded font-mono text-[8px] font-bold tracking-[0.10em] text-white/85 bg-black/55 border border-white/15 backdrop-blur-sm">
              {s.shots}
            </span>
            <div class="qg-scrub" data-scrub>
              <div class="qg-scrub-fill"></div>
              <div class="qg-scrub-thumb"></div>
            </div>
          </div>
          <div class="p-2.5 sm:p-3">
            <div class="text-[10.5px] sm:text-[11px] text-white font-semibold leading-tight truncate" title={s.movie}>{s.movie}</div>
            <div class="text-[9.5px] sm:text-[10px] text-white/40 mt-1 leading-snug">{s.style}</div>
          </div>
        </div>
      ))}
    </div>
  </div>

</section>

<script>
  // Autoplay sample videos when they scroll into view; pause when off-screen. Same behavior on
  // every device. The custom scrubber works alongside it via the `_scrubbing` guard.
  const samples = document.querySelectorAll<HTMLElement>('.sample-card');

  samples.forEach(card => {
    const video = card.querySelector<HTMLVideoElement>('video.sample-video');
    if (!video) return;

    const scrub = card.querySelector<HTMLElement>('[data-scrub]');
    if (!scrub) return;
    const fill  = scrub.querySelector<HTMLElement>('.qg-scrub-fill');
    const thumb = scrub.querySelector<HTMLElement>('.qg-scrub-thumb');
    if (!fill || !thumb) return;

    const update = () => {
      const d = video.duration;
      if (!d || !isFinite(d)) return;
      const pct = (video.currentTime / d) * 100;
      fill.style.width = pct + '%';
      thumb.style.left = pct + '%';
    };
    video.addEventListener('timeupdate', update);
    video.addEventListener('loadedmetadata', update);

    const seek = (clientX: number) => {
      const r = scrub.getBoundingClientRect();
      if (r.width <= 0) return;
      let p = (clientX - r.left) / r.width;
      p = Math.min(1, Math.max(0, p));
      if (video.duration && isFinite(video.duration)) {
        video.currentTime = p * video.duration;
        update();
      }
    };

    let dragging = false, wasPlaying = false;
    scrub.addEventListener('pointerdown', (e: PointerEvent) => {
      e.preventDefault();
      dragging = true;
      (video as any)._scrubbing = true;
      wasPlaying = !video.paused;
      video.pause();
      scrub.classList.add('is-dragging');
      scrub.setPointerCapture(e.pointerId);
      seek(e.clientX);
    });
    scrub.addEventListener('pointermove', (e: PointerEvent) => {
      if (dragging) seek(e.clientX);
    });
    const end = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      (video as any)._scrubbing = false;
      scrub.classList.remove('is-dragging');
      try { scrub.releasePointerCapture(e.pointerId); } catch {}
      if (wasPlaying) video.play().catch(() => {});
    };
    scrub.addEventListener('pointerup', end);
    scrub.addEventListener('pointercancel', end);
  });

  // Single shared IntersectionObserver — plays each sample video while it's at least 35% on screen.
  const playObserver = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      const v = e.target as HTMLVideoElement;
      if ((v as any)._scrubbing) return;
      if (e.isIntersecting) v.play().catch(() => {});
      else v.pause();
    });
  }, { threshold: 0.35 });
  document.querySelectorAll<HTMLVideoElement>('.sample-video').forEach(v => playObserver.observe(v));
</script>
