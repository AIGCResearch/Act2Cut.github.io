<section id="abstract" class="glass-card rounded-2xl sm:rounded-3xl p-6 sm:p-8 md:p-12 border border-white/[0.12] shadow-2xl space-y-5 sm:space-y-6">
  <div class="flex items-center gap-3 mb-1 sm:mb-2">
