---
// Glass-card qualitative gallery — real Act2Cut results from /public/compare_home.
// 4 tabs (T2V / I2V / S2V / V2V), responsive grid.
//   T2V: generated mp4 only.
//   I2V: condition_frame.png above generated mp4.
//   S2V: storyboard reference frames row above generated mp4.
//   V2V: condition_video.mp4 above generated mp4.

import { readFileSync } from 'fs';
import { join } from 'path';
import { galleryData } from '../data/galleryData';
import DualVideo from './DualVideo.astro';

const publicDir = join(process.cwd(), 'public');

type CaptionJson = Record<string, string>;

function loadCaptionJson(videoPath: string): CaptionJson | null {
  const captionPath = videoPath.replace('.mp4', '_caption.json');
  try {
    return JSON.parse(readFileSync(join(publicDir, captionPath), 'utf-8'));
  } catch {
    return null;
  }
}

// Augment each gallery item with structured caption data
const galleryWithCaptions = Object.fromEntries(
  Object.entries(galleryData).map(([mode, items]) => [
    mode,
    items.map(item => ({ ...item, captionData: loadCaptionJson(item.video) }))
  ])
) as Record<string, (typeof galleryData['t2v'][0] & { captionData: CaptionJson | null })[]>;

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const tabs = [
  { id: 'qg-t2v', label: 'T2V', sub: 'Text → Video',         mode: 't2v' as const },
  { id: 'qg-i2v', label: 'I2V', sub: 'Image → Video',        mode: 'i2v' as const },
  { id: 'qg-s2v', label: 'S2V', sub: 'Storyboard → Video',   mode: 's2v' as const },
  { id: 'qg-v2v', label: 'V2V', sub: 'Video → Video',        mode: 'v2v' as const },
];

interface Props {
  instanceId?: string;
  showHeader?: boolean;
}
const { instanceId = 'qg-default', showHeader = true } = Astro.props;
---

<div class="qualitative-gallery space-y-6 md:space-y-8" data-gallery-id={instanceId}>

  {showHeader && (
    <div class="text-center" data-reveal>
      <span class="text-[10px] font-bold tracking-[0.32em] uppercase text-white/40 block mb-3">Generated Sequences</span>
      <h3 class="text-2xl md:text-3xl font-semibold tracking-tight">Inference Outputs</h3>
      <p class="text-white/45 text-sm mt-2 max-w-md mx-auto">Native multi-shot generation across four input modalities.</p>
    </div>
  )}

  <!-- Pill tab bar -->
  <div class="flex justify-center" data-reveal style="transition-delay:60ms">
    <div class="glass-card inline-flex items-center gap-1 p-1 rounded-full border border-white/[0.08] shadow-inner">
      {tabs.map((tab, i) => (
        <button
          class={`qg-tab-btn relative px-4 sm:px-5 py-1.5 rounded-full text-[11px] font-bold tracking-[0.18em] uppercase transition-all duration-300 ${
            i === 0
              ? 'bg-white text-black shadow-[0_2px_12px_rgba(255,255,255,0.18)]'
              : 'text-white/55 hover:text-white/85'
          }`}
          data-tab={tab.id}
          title={tab.sub}
        >
          {tab.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Panels -->
  {tabs.map((tab, ti) => {
    const items = galleryWithCaptions[tab.mode] ?? [];
    return (
      <div
        id={tab.id}
        class:list={['qg-tab-panel', ti !== 0 && 'hidden']}
        data-mode={tab.mode}
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-5">
          {items.map((item, idx) => (
            <article
              class="qg-card group relative glass-card rounded-2xl overflow-hidden border border-white/[0.08] shadow-2xl transition-all duration-500 hover:border-white/[0.18] hover:-translate-y-0.5 hover:shadow-[0_24px_60px_rgba(0,0,0,0.5)]"
              data-reveal
              style={`transition-delay:${Math.min(idx * 50, 300)}ms`}
            >
              <!-- Glass sheen highlight -->
              <div
                class="absolute inset-0 pointer-events-none opacity-60 mix-blend-overlay"
                style="background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, transparent 35%, transparent 70%, rgba(255,255,255,0.04) 100%);"
              ></div>

              {/* T2V: just the generated multi-shot video */}
              {tab.mode === 't2v' && (
                <div class="qg-video-wrap relative cinema-aspect bg-black/60 overflow-hidden">
                  <span class="absolute top-3 left-3 z-10 px-2 py-0.5 rounded-md text-[8px] font-bold tracking-[0.18em] uppercase bg-[#ff4d4d]/85 text-white shadow-lg shadow-[#ff4d4d]/20 backdrop-blur-sm">
                    Generated
                  </span>
                  <DualVideo src={`${base}/${item.video}`} class="qg-video absolute inset-0 w-full h-full object-contain" />
                  <div class="qg-scrub" data-scrub>
                    <div class="qg-scrub-fill"></div>
                    <div class="qg-scrub-thumb"></div>
                  </div>
                </div>
              )}

              {/* I2V: input frame + generated */}
              {tab.mode === 'i2v' && (
                <div class="relative">
                  <div class="relative cinema-aspect bg-black/55 overflow-hidden">
                    <span class="absolute top-3 left-3 z-10 px-2 py-0.5 rounded-md text-[8px] font-bold tracking-[0.18em] uppercase bg-black/55 text-white/85 border border-white/15 backdrop-blur-sm">
                      Input Frame
                    </span>
                    {item.condFrame && (
                      <img src={`${base}/${item.condFrame}`} class="absolute inset-0 w-full h-full object-contain" alt="Input frame" loading="lazy" />
                    )}
                  </div>
                  <div class="absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 z-20 w-6 h-6 rounded-full bg-black border border-white/15 flex items-center justify-center shadow-lg">
                    <svg class="w-3 h-3 text-[#ffb84d]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                  </div>
                  <div class="qg-video-wrap relative cinema-aspect bg-black/60 overflow-hidden border-t border-white/[0.08]">
                    <span class="absolute top-3 left-3 z-10 px-2 py-0.5 rounded-md text-[8px] font-bold tracking-[0.18em] uppercase bg-[#ff4d4d]/85 text-white shadow-lg shadow-[#ff4d4d]/20 backdrop-blur-sm">
                      Generated
                    </span>
                    <DualVideo src={`${base}/${item.video}`} class="qg-video absolute inset-0 w-full h-full object-contain" />
                    <div class="qg-scrub" data-scrub>
                      <div class="qg-scrub-fill"></div>
                      <div class="qg-scrub-thumb"></div>
                    </div>
                  </div>
                </div>
              )}

              {/* S2V: storyboard reference frames row + generated */}
              {tab.mode === 's2v' && (
                <div class="relative">
                  <div class="relative bg-black/55 overflow-hidden">
                    <span class="absolute top-3 left-3 z-10 px-2 py-0.5 rounded-md text-[8px] font-bold tracking-[0.18em] uppercase bg-black/55 text-white/85 border border-white/15 backdrop-blur-sm">
                      Storyboard · {item.storyboards?.length ?? 0} refs
                    </span>
                    <div
                      class="grid gap-1 p-2 pt-9"
                      style={`grid-template-columns: repeat(${Math.max(item.storyboards?.length ?? 1, 1)}, minmax(0, 1fr));`}
                    >
                      {(item.storyboards ?? []).map((sb, k) => (
                        <div class="relative cinema-aspect rounded-sm bg-black/55 border border-white/10 overflow-hidden">
                          <img src={`${base}/${sb}`} class="absolute inset-0 w-full h-full object-contain" alt={`Storyboard ${k+1}`} loading="lazy" />
                          <span class="absolute bottom-0.5 right-0.5 font-mono text-[7.5px] tracking-[0.10em] text-white/85 bg-black/55 px-1 rounded">
                            R{k+1}
                          </span>
                        </div>
                      ))}
                    </div>
                  </div>
                  <div class="qg-video-wrap relative cinema-aspect bg-black/60 overflow-hidden border-t border-white/[0.08]">
                    <span class="absolute top-3 left-3 z-10 px-2 py-0.5 rounded-md text-[8px] font-bold tracking-[0.18em] uppercase bg-[#ff4d4d]/85 text-white shadow-lg shadow-[#ff4d4d]/20 backdrop-blur-sm">
                      Generated
                    </span>
                    <DualVideo src={`${base}/${item.video}`} class="qg-video absolute inset-0 w-full h-full object-contain" />
                    <div class="qg-scrub" data-scrub>
                      <div class="qg-scrub-fill"></div>
                      <div class="qg-scrub-thumb"></div>
                    </div>
                  </div>
                </div>
              )}

              {/* V2V: prev-shot clip + generated */}
              {tab.mode === 'v2v' && (
                <div class="relative">
                  <div class="qg-video-wrap relative cinema-aspect bg-black/55 overflow-hidden">
                    <span class="absolute top-3 left-3 z-10 px-2 py-0.5 rounded-md text-[8px] font-bold tracking-[0.18em] uppercase bg-black/55 text-white/85 border border-white/15 backdrop-blur-sm">
                      Prev Shot
                    </span>
                    {item.condVideo && (
                      <DualVideo src={`${base}/${item.condVideo}`} class="qg-video absolute inset-0 w-full h-full object-contain" />
                    )}
                    <div class="qg-scrub" data-scrub>
                      <div class="qg-scrub-fill"></div>
                      <div class="qg-scrub-thumb"></div>
                    </div>
                  </div>
                  <div class="qg-video-wrap relative cinema-aspect bg-black/60 overflow-hidden border-t border-white/[0.08]">
                    <span class="absolute top-3 left-3 z-10 px-2 py-0.5 rounded-md text-[8px] font-bold tracking-[0.18em] uppercase bg-[#ff4d4d]/85 text-white shadow-lg shadow-[#ff4d4d]/20 backdrop-blur-sm">
                      Generated
                    </span>
                    <DualVideo src={`${base}/${item.video}`} class="qg-video absolute inset-0 w-full h-full object-contain" />
                    <div class="qg-scrub" data-scrub>
                      <div class="qg-scrub-fill"></div>
                      <div class="qg-scrub-thumb"></div>
                    </div>
                  </div>
                </div>
              )}

              <!-- Caption body -->
              <div class="qg-prompt-block relative p-4 md:p-5 border-t border-white/[0.06]">
                {(() => {
                  const cd = item.captionData;
                  const charKeys = cd ? Object.keys(cd).filter(k => /^character\d+$/.test(k)) : [];
                  const shotKeys = cd ? Object.keys(cd).filter(k => /^shot\d+$/.test(k)) : [];
                  const relKeys  = cd ? Object.keys(cd).filter(k => /^shot\d+-\d+$/.test(k)) : [];
                  return (
                    <>
                      <div class="flex items-center justify-between gap-2 mb-2 flex-wrap">
                        <span class="text-[10px] font-bold tracking-[0.18em] uppercase text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d]">
                          {item.shots.length}-shot · {item.shots.join(' → ')}
                        </span>
                        <button
                          class="qg-prompt-toggle text-[9px] font-bold tracking-[0.18em] uppercase text-white/45 hover:text-[#ffb84d] transition-colors flex items-center gap-1"
                          type="button"
                          aria-expanded="false"
                        >
                          <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                          All Prompts
                        </button>
                      </div>
                      <p class="qg-prompt-summary text-[11.5px] leading-relaxed text-white/65 font-light cursor-help line-clamp-3">
                        {cd?.global_action?.replace(/^Global Action\/Motion:\s*/i, '') ?? item.caption}
                      </p>

                      <div class="qg-prompt-popover" role="dialog" aria-label="Full prompts">
                        <div class="qg-prompt-popover-inner">
                          <div class="flex items-center justify-between gap-2 mb-3">
                            <span class="text-[10px] font-bold tracking-[0.20em] uppercase text-[#ffb84d]">Full Prompts</span>
                            <span class="text-[9.5px] text-white/40">{item.shots.length} shots · click outside to close</span>
                          </div>
                          <div class="qg-prompt-list thin-scroll space-y-2">
                            {cd ? (
                              <>
                                {/* Global section */}
                                <div class="space-y-1.5 pb-2 border-b border-white/[0.08]">
                                  {cd.global_setting && (
                                    <p class="text-[10.5px] leading-relaxed text-white/75">
                                      <span class="inline-block px-1.5 py-0.5 mr-1.5 mb-0.5 rounded bg-[#ff4d4d]/15 border border-[#ff4d4d]/25 font-mono text-[8.5px] tracking-[0.10em] text-[#ffb84d]">Global Setting</span>
                                      {cd.global_setting.replace(/^Global Setting:\s*/i, '')}
                                    </p>
                                  )}
                                  {cd.global_action && (
                                    <p class="text-[10.5px] leading-relaxed text-white/75">
                                      <span class="inline-block px-1.5 py-0.5 mr-1.5 mb-0.5 rounded bg-[#ff4d4d]/15 border border-[#ff4d4d]/25 font-mono text-[8.5px] tracking-[0.10em] text-[#ffb84d]">Global Action</span>
                                      {cd.global_action.replace(/^Global Action\/Motion:\s*/i, '')}
                                    </p>
                                  )}
                                  {charKeys.map(k => (
                                    <p class="text-[10.5px] leading-relaxed text-white/75">
                                      <span class="inline-block px-1.5 py-0.5 mr-1.5 mb-0.5 rounded bg-white/[0.08] border border-white/10 font-mono text-[8.5px] tracking-[0.10em] text-white/65 capitalize">{k.replace('character', 'Character ')}</span>
                                      {(cd[k] ?? '').replace(/^\[character\d+\]\s+is\s+/i, '')}
                                    </p>
                                  ))}
                                </div>
                                {/* Per-shot section */}
                                {shotKeys.length > 0 && (
                                  <div class="space-y-1.5 pb-2 border-b border-white/[0.08]">
                                    {shotKeys.map((k, ki) => (
                                      <p class="text-[10.5px] leading-relaxed text-white/75">
                                        <span class="inline-block px-1.5 py-0.5 mr-1.5 mb-0.5 rounded bg-white/[0.08] border border-white/10 font-mono text-[8.5px] tracking-[0.10em] text-white/65">Shot {ki + 1}</span>
                                        {cd[k]}
                                      </p>
                                    ))}
                                  </div>
                                )}
                                {/* Relations section */}
                                {relKeys.length > 0 && (
                                  <div class="space-y-1.5">
                                    {relKeys.map(k => (
                                      <p class="text-[10.5px] leading-relaxed text-white/75">
                                        <span class="inline-block px-1.5 py-0.5 mr-1.5 mb-0.5 rounded bg-[#ffb84d]/10 border border-[#ffb84d]/20 font-mono text-[8.5px] tracking-[0.10em] text-[#ffb84d]/80">{k.replace('shot', 'Shot ').replace('-', ' → ')}</span>
                                        {cd[k]}
                                      </p>
                                    ))}
                                  </div>
                                )}
                              </>
                            ) : (
                              <ol class="space-y-2">
                                {item.fullPrompts.map((p, k) => (
                                  <li class="text-[10.5px] leading-relaxed text-white/75">
                                    <span class="inline-block px-1.5 py-0.5 mr-1.5 rounded bg-white/[0.08] border border-white/10 font-mono text-[8.5px] tracking-[0.10em] text-white/65">Shot {k + 1}</span>
                                    {p}
                                  </li>
                                ))}
                              </ol>
                            )}
                          </div>
                        </div>
                      </div>
                    </>
                  );
                })()}
              </div>
            </article>
          ))}
        </div>
      </div>
    );
  })}
</div>

<script>
  // Tab switching for all instances of qualitative-gallery on the page
  document.querySelectorAll<HTMLElement>('.qualitative-gallery').forEach((gallery) => {
    const btns   = gallery.querySelectorAll<HTMLButtonElement>('.qg-tab-btn');
    const panels = gallery.querySelectorAll<HTMLElement>('.qg-tab-panel');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.dataset.tab!;

        btns.forEach(b => {
          b.classList.remove('bg-white','text-black','shadow-[0_2px_12px_rgba(255,255,255,0.18)]');
          b.classList.add('text-white/55','hover:text-white/85');
        });
        btn.classList.remove('text-white/55','hover:text-white/85');
        btn.classList.add('bg-white','text-black','shadow-[0_2px_12px_rgba(255,255,255,0.18)]');

        panels.forEach(p => {
          if (p.id === targetId) {
            p.classList.remove('hidden');
            p.style.opacity = '0';
            p.style.transform = 'translateY(8px)';
            requestAnimationFrame(() => requestAnimationFrame(() => {
              p.style.transition = 'opacity 380ms cubic-bezier(0.22,1,0.36,1), transform 380ms cubic-bezier(0.22,1,0.36,1)';
              p.style.opacity = '1';
              p.style.transform = 'translateY(0)';
            }));
            // pause non-visible videos in other panels
            gallery.querySelectorAll<HTMLVideoElement>('.qg-tab-panel.hidden video.qg-video').forEach(v => v.pause());
          } else {
            p.classList.add('hidden');
            p.style.transition = '';
            p.style.opacity = '';
            p.style.transform = '';
          }
        });
      });
    });

    // Autoplay any video that scrolls into view; pause it as soon as it leaves. Same behavior on
     // every device — no hover dance — and the browser only decodes what's actually on screen.
    // The `_scrubbing` guard keeps the user's manual seek from being overridden by the observer.
    const playObserver = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        const v = e.target as HTMLVideoElement;
        if ((v as any)._scrubbing) return;
        if (e.isIntersecting) v.play().catch(() => {});
        else v.pause();
      });
    }, { threshold: 0.35 });
    gallery.querySelectorAll<HTMLVideoElement>('video.qg-video').forEach(v => playObserver.observe(v));

    // Per-shot prompt popover: hover-triggered (CSS) + click-to-pin via toggle button. ESC / outside-click unpins.
    gallery.querySelectorAll<HTMLElement>('.qg-prompt-block').forEach(block => {
      const toggle = block.querySelector<HTMLButtonElement>('.qg-prompt-toggle');
      if (!toggle) return;
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const pinned = block.classList.toggle('is-pinned');
        toggle.setAttribute('aria-expanded', pinned ? 'true' : 'false');
      });
    });
    document.addEventListener('click', (e) => {
      gallery.querySelectorAll<HTMLElement>('.qg-prompt-block.is-pinned').forEach(block => {
        if (!block.contains(e.target as Node)) {
          block.classList.remove('is-pinned');
          block.querySelector('.qg-prompt-toggle')?.setAttribute('aria-expanded', 'false');
        }
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      gallery.querySelectorAll<HTMLElement>('.qg-prompt-block.is-pinned').forEach(block => {
        block.classList.remove('is-pinned');
        block.querySelector('.qg-prompt-toggle')?.setAttribute('aria-expanded', 'false');
      });
    });

    // Scrubber: thin click/drag progress bar overlay per .qg-video-wrap
    gallery.querySelectorAll<HTMLElement>('.qg-video-wrap').forEach(wrap => {
      const video = wrap.querySelector<HTMLVideoElement>('video.qg-video');
      const scrub = wrap.querySelector<HTMLElement>('[data-scrub]');
      if (!video || !scrub) return;
      const fill = scrub.querySelector<HTMLElement>('.qg-scrub-fill');
      const thumb = scrub.querySelector<HTMLElement>('.qg-scrub-thumb');
      if (!fill || !thumb) return;

      const update = () => {
        const d = video.duration;
        if (!d || !isFinite(d)) return;
        const pct = (video.currentTime / d) * 100;
        fill.style.width = pct + '%';
        thumb.style.left = pct + '%';
      };
      video.addEventListener('timeupdate', update);
      video.addEventListener('loadedmetadata', update);

      const seekFromEvent = (clientX: number) => {
        const r = scrub.getBoundingClientRect();
        if (r.width <= 0) return;
        let p = (clientX - r.left) / r.width;
        p = Math.min(1, Math.max(0, p));
        if (video.duration && isFinite(video.duration)) {
          video.currentTime = p * video.duration;
          update();
        }
      };

      let dragging = false;
      let wasPlaying = false;

      const onPointerDown = (e: PointerEvent) => {
        e.preventDefault();
        dragging = true;
        (video as any)._scrubbing = true;
        wasPlaying = !video.paused;
        video.pause();
        scrub.classList.add('is-dragging');
        scrub.setPointerCapture(e.pointerId);
        seekFromEvent(e.clientX);
      };
      const onPointerMove = (e: PointerEvent) => {
        if (!dragging) return;
        seekFromEvent(e.clientX);
      };
      const onPointerUp = (e: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        (video as any)._scrubbing = false;
        scrub.classList.remove('is-dragging');
        try { scrub.releasePointerCapture(e.pointerId); } catch {}
        if (wasPlaying) video.play().catch(() => {});
      };

      scrub.addEventListener('pointerdown', onPointerDown);
      scrub.addEventListener('pointermove', onPointerMove);
      scrub.addEventListener('pointerup', onPointerUp);
      scrub.addEventListener('pointercancel', onPointerUp);
    });
  });
</script>
