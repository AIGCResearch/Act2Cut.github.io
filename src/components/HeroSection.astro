---
const isAnonymous = import.meta.env.BUILD_MODE === 'anonymous';

const authors = [
  { name: 'Cailin Zhuang', affil: '1,2,3*†' },
  { name: 'Yaoqi Hu',      affil: '2'    },
  { name: 'Zheng Dong',    affil: '2'    },
  { name: 'Shiwen Zhang',  affil: '1'      },
  { name: 'Haibin Huang',  affil: '1†'     },
  { name: 'Chi Zhang',     affil: '1'     },
  { name: 'Xuelong Li',    affil: '1‡'     },
];

const authorRows = [authors.slice(0, 3), authors.slice(3)];

const affiliations = [
  { id: '1', name: 'Institute of Artificial Intelligence, China Telecom (TeleAI)' },
  { id: '2', name: 'AIGC Research' },
  { id: '3', name: 'Fudan University' },
];

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const heroActionClass = 'glass-arch px-4 sm:px-7 md:px-8 py-2.5 sm:py-3.5 rounded-full flex items-center gap-2 sm:gap-2.5 text-[13px] sm:text-sm font-medium group select-none transition-all duration-200 hover:scale-[1.02] active:scale-95';
---

<!-- HEADER / TITLE -->
<header class="text-center space-y-8 sm:space-y-10 mt-8 sm:mt-12 md:mt-16 mb-8 sm:mb-12 px-2 sm:px-4">
  <div data-reveal>
    <h1 class="text-[1.72rem] sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.12] max-w-5xl mx-auto">
      <span class="flex items-center justify-center gap-3 sm:gap-4 md:gap-5 mb-3 sm:mb-4">
        <span class="clapperboard text-[2.1rem] sm:text-5xl md:text-6xl lg:text-7xl leading-none drop-shadow-[0_4px_14px_rgba(255,77,77,0.25)] select-none" aria-hidden="true">🎬</span>
        <span class="text-[2.05rem] sm:text-5xl md:text-6xl lg:text-7xl text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d] leading-none">Act2Cut</span>
      </span>
      <span class="block whitespace-nowrap mb-1 text-[1.35rem] sm:text-[2.35rem] md:text-[2.875rem] lg:text-[4.25rem]">Continuous Multi-Shot Video</span>
      <span class="block whitespace-nowrap text-[1rem] sm:text-[2.35rem] md:text-[2.875rem] lg:text-[4.25rem]">Narrative Match on <span class="text-transparent bg-clip-text bg-gradient-to-b from-white to-white/30">Action-Cut</span></span>
    </h1>
  </div>

  {!isAnonymous && (
  <div class="relative" data-reveal style="transition-delay:100ms">
    <!-- Soft dark halo — larger feathered ellipse for readability; hidden in light mode -->
    <div class="hero-scrim"></div>
    <div class="relative space-y-4 sm:space-y-5">
      <div class="space-y-2 text-[14px] sm:text-[16px] md:text-[17px]">
        {authorRows.map(row => (
          <div class="flex flex-wrap justify-center gap-x-5 gap-y-2">
            {row.map(author => (
              <span class="font-medium text-white/90">
                {author.name}<sup class="text-white/70 ml-0.5">{author.affil}</sup>
              </span>
            ))}
          </div>
        ))}
      </div>
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-1.5 text-[12px] sm:text-[14px] md:text-[15px] text-white/60">
        {affiliations.map(affil => (
          <span><sup class="mr-0.5">{affil.id}</sup>{affil.name}</span>
        ))}
      </div>
      <div class="text-[11.5px] sm:text-[13px] text-white/40 font-light flex flex-wrap justify-center gap-x-5 gap-y-1">
        <span>* Work done during internship at TeleAI.</span>
        <span>† Project Lead.</span>
        <span>‡ Corresponding author.</span>
      </div>
    </div>
  </div>
  )}

  <!-- ACTION BUTTONS -->
  <div class="space-y-7 sm:space-y-8" data-reveal style="transition-delay:200ms">
    <div class="flex flex-wrap justify-center gap-2.5 sm:gap-4 md:gap-6">
      {!isAnonymous && (
      <a href="#poster" class={heroActionClass}>
        <svg class="w-4 h-4 opacity-80 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 3h9l3 3v15H6a2 2 0 01-2-2V5a2 2 0 012-2zm2 6h8M8 13h8M8 17h5"/></svg>
        Poster
      </a>
      )}
      <a href="#" class={heroActionClass}>
        <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 group-hover:scale-110 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        Paper（Coming Soon）
      </a>
      <a href="#" class={heroActionClass}>
        <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 group-hover:rotate-12 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
        Code（Coming Soon）
      </a>
      <a href={isAnonymous ? '#' : 'https://huggingface.co/datasets/AIGC-Research/ActCutVid'} target={isAnonymous ? undefined : '_blank'} rel={isAnonymous ? undefined : 'noopener noreferrer'} class={heroActionClass}>
        <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 group-hover:scale-110 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3" stroke-width="2" stroke-linecap="round"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5v6c0 1.657 4.03 3 9 3s9-1.343 9-3V5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 11v6c0 1.657 4.03 3 9 3s9-1.343 9-3v-6"/></svg>
        {isAnonymous ? 'Dataset（Coming Soon）' : 'Dataset'}
      </a>
      {!isAnonymous && (
      <a href="https://huggingface.co/AIGC-Research/Act2Cut" target="_blank" rel="noopener noreferrer" class={heroActionClass}>
        <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m12 3 9 5-9 5-9-5 9-5Zm-9 5v8l9 5 9-5V8M12 13v8"/></svg>
        Model
      </a>
      )}
      {!isAnonymous && (
      <a href="https://huggingface.co/datasets/AIGC-Research/ActCutBench" target="_blank" rel="noopener noreferrer" class={heroActionClass}>
        <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 20V10m5 10V4m5 16v-7m5 7V8M2 20h20"/></svg>
        Benchmark
      </a>
      )}
    </div>

    {!isAnonymous && (
    <div class="glass-arch mx-auto flex w-full max-w-[720px] flex-wrap items-center justify-center gap-3 rounded-2xl px-3 py-4 sm:rounded-3xl sm:px-10 sm:py-5" aria-label="Institution logos">
      <img src={`${base}/images/aigc-research-light.png`} class="block h-[80px] w-[300px] max-w-full object-contain sm:h-[88px] sm:w-[330px] dark:hidden" alt="AIGC Research" loading="eager" />
      <img src={`${base}/images/aigc-research-dark.png`} class="hidden h-[80px] w-[300px] max-w-full object-contain sm:h-[88px] sm:w-[330px] dark:block" alt="AIGC Research" loading="eager" />
      <img src={`${base}/images/teleai-logo.png`} class="h-[80px] w-[80px] object-contain sm:h-[88px] sm:w-[88px]" alt="TeleAI, Institute of Artificial Intelligence, China Telecom" loading="eager" />
      <img src={`${base}/images/fudan-university.png`} class="h-[80px] w-[80px] object-contain sm:h-[88px] sm:w-[88px]" alt="Fudan University" loading="eager" />
      <img src={`${base}/images/shanghaitech-university.svg`} class="h-[80px] w-[80px] object-contain sm:h-[88px] sm:w-[88px]" alt="ShanghaiTech University" loading="eager" />
    </div>
    )}
  </div>
</header>

<!-- HERO VIDEO with letterbox + timecode -->
