---
const isAnonymous = import.meta.env.BUILD_MODE === 'anonymous';

const authors: { name: string; affil: string; notes: string; url?: string }[] = [
  { name: 'Cailin Zhuang', affil: '1,2,3,4', notes: '*†', url: 'https://journey-zhuang.github.io/' },
  { name: 'Yaoqi Hu',      affil: '2',       notes: ''   },
  { name: 'Zheng Dong',    affil: '2',       notes: ''   },
  { name: 'Shiwen Zhang',  affil: '1',       notes: ''   },
  { name: 'Haibin Huang',  affil: '1',       notes: '†'  },
  { name: 'Chi Zhang',     affil: '1',       notes: ''   },
  { name: 'Xuelong Li',    affil: '1',       notes: '‡'  },
];

const authorRows = [authors.slice(0, 3), authors.slice(3)];

const affiliations = [
  { id: '1', name: 'Institute of Artificial Intelligence, China Telecom (TeleAI)' },
  { id: '2', name: 'ActXCut Team, AIGC Research' },
  { id: '3', name: 'Fudan University' },
  { id: '4', name: 'ShanghaiTech University' },
];

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const heroResourceClass = 'px-4 sm:px-7 md:px-8 py-2.5 sm:py-3.5 rounded-full bg-white/[0.07] backdrop-blur-md active:scale-95 border border-white/25 transition-all duration-200 flex items-center gap-2 sm:gap-2.5 text-[13px] sm:text-sm font-medium group shadow-[0_0_0_0_rgba(255,255,255,0)] hover:shadow-[0_0_20px_rgba(255,255,255,0.12)] select-none';
---

<!-- HEADER / TITLE -->
<header class="text-center space-y-8 sm:space-y-10 mt-8 sm:mt-12 md:mt-16 mb-8 sm:mb-12 px-2 sm:px-4">
  <div data-reveal>
    <h1 id="hero-title" class="text-[1.72rem] sm:text-5xl md:text-6xl lg:text-[3.35rem] xl:text-[4.25rem] font-bold tracking-tight leading-[1.12] max-w-[1400px] mx-auto">
      <span class="flex items-center justify-center gap-3 sm:gap-4 md:gap-5 mb-3 sm:mb-4">
        <span class="clapperboard text-[2.1rem] sm:text-5xl md:text-6xl lg:text-7xl leading-none drop-shadow-[0_4px_14px_rgba(255,77,77,0.25)] select-none" aria-hidden="true">🎬</span>
        <span class="hero-brand-gradient text-[2.05rem] sm:text-5xl md:text-6xl lg:text-7xl text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d] leading-none">Act2Cut</span>
      </span>
      <span class="block mb-1 text-[1.35rem] sm:text-[2.35rem] md:text-[2.875rem] lg:text-[3.35rem] xl:text-[4.25rem]"><span class="hero-title-flicker">Continuous Multi-Shot Video Narrative</span></span>
      <span class="block text-[1rem] sm:text-[2.35rem] md:text-[2.875rem] lg:text-[3.35rem] xl:text-[4.25rem]"><span class="hero-title-flicker">Match on <span class="hero-action-cut">Action-Cut</span></span></span>
    </h1>
  </div>

  {!isAnonymous && (
  <div class="relative" data-reveal style="transition-delay:100ms">
    <!-- Soft dark halo — larger feathered ellipse for readability; hidden in light mode -->
    <div class="hero-scrim"></div>
    <div class="relative space-y-4 sm:space-y-5">
      <div class="space-y-2.5 text-[16px] sm:text-[18px] md:text-[20px]">
        {authorRows.map(row => (
          <div class="flex flex-wrap justify-center gap-x-4 sm:gap-x-5 gap-y-2">
            {row.map(author => (
              <span class="whitespace-nowrap font-semibold text-white/90">
                {author.url
                  ? <a href={author.url} target="_blank" rel="noopener noreferrer" class="text-inherit underline decoration-[#ffb84d]/50 underline-offset-4 transition-colors hover:text-[#9a4d19] dark:hover:text-[#ffb84d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ffb84d]">{author.name}</a>
                  : author.name}<sup class="hero-meta-marker ml-1 text-[13px] sm:text-[14px] md:text-[15px] font-extrabold tracking-[0.02em]">{author.affil}{author.notes && <span class="ml-0.5">{author.notes}</span>}</sup>
              </span>
            ))}
          </div>
        ))}
      </div>
      <div class="mx-auto flex max-w-5xl flex-col items-center gap-2 text-center text-[14px] sm:text-[15px] md:text-[16px] text-white/75">
        <span class="inline-flex max-w-full items-baseline justify-center gap-1.5 leading-snug"><span class="hero-meta-marker shrink-0 font-extrabold">{affiliations[0].id}</span><span>{affiliations[0].name}</span></span>
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
          {affiliations.slice(1).map(affil => (
            <span class="inline-flex items-baseline gap-1.5 leading-snug"><span class="hero-meta-marker font-extrabold">{affil.id}</span><span>{affil.name}</span></span>
          ))}
        </div>
      </div>
      <div class="flex flex-wrap justify-center gap-2 text-[12px] sm:text-[13px] font-medium">
        <span class="inline-flex max-w-full items-start gap-2 rounded-full border border-white/[0.14] bg-white/[0.06] px-3 py-1.5 text-white/80 shadow-sm"><span class="hero-meta-marker font-extrabold">*</span>Work done during internship at TeleAI.</span>
        <span class="inline-flex max-w-full items-start gap-2 rounded-full border border-white/[0.14] bg-white/[0.06] px-3 py-1.5 text-white/80 shadow-sm"><span class="hero-meta-marker font-extrabold">†</span>Project Lead.</span>
        <span class="inline-flex max-w-full items-start gap-2 rounded-full border border-white/[0.14] bg-white/[0.06] px-3 py-1.5 text-white/80 shadow-sm"><span class="hero-meta-marker font-extrabold">‡</span>Corresponding author.</span>
      </div>
    </div>
  </div>
  )}

  {!isAnonymous && (
  <div class="hero-team-logo flex items-center justify-center" data-reveal style="transition-delay:180ms" aria-label="ActXCut Team logo">
    <img src={`${base}/images/actxcut-team-light.png`} class="block h-[48px] w-[280px] max-w-full object-contain sm:h-[58px] sm:w-[320px] xl:h-[68px] xl:w-[360px] dark:hidden" alt="ActXCut Team" loading="eager" />
    <img src={`${base}/images/actxcut-team-dark.png`} class="hidden h-[48px] w-[280px] max-w-full object-contain sm:h-[58px] sm:w-[320px] xl:h-[68px] xl:w-[360px] dark:block" alt="ActXCut Team" loading="eager" />
  </div>
  )}

  <!-- ACTION BUTTONS -->
  <div class="hero-resource-group space-y-7 sm:space-y-8">
    <div class="flex flex-wrap justify-center gap-2.5 sm:gap-4 md:gap-6" data-reveal style="transition-delay:200ms">
      {!isAnonymous && (
      <a href="#poster" class={heroResourceClass}>
        <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 group-hover:scale-110 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 3h9l3 3v15H6a2 2 0 01-2-2V5a2 2 0 012-2zm2 6h8M8 13h8M8 17h5"/></svg>
        Poster
      </a>
      )}
      <a href="#" class={heroResourceClass}>
        <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 group-hover:scale-110 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        Paper（Coming）
      </a>
      <a href="#" class={heroResourceClass}>
        <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 group-hover:rotate-12 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
        Code（Coming）
      </a>
      <a href={isAnonymous ? '#' : 'https://huggingface.co/datasets/AIGC-Research/ActCutVid'} target={isAnonymous ? undefined : '_blank'} rel={isAnonymous ? undefined : 'noopener noreferrer'} class={heroResourceClass}>
        <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 group-hover:scale-110 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3" stroke-width="2" stroke-linecap="round"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5v6c0 1.657 4.03 3 9 3s9-1.343 9-3V5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 11v6c0 1.657 4.03 3 9 3s9-1.343 9-3v-6"/></svg>
        {isAnonymous ? 'Dataset（Coming）' : 'Dataset'}
      </a>
      {!isAnonymous && (
      <a href="https://huggingface.co/AIGC-Research/Act2Cut" target="_blank" rel="noopener noreferrer" class={heroResourceClass}>
        <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 group-hover:scale-110 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m12 3 9 5-9 5-9-5 9-5Zm-9 5v8l9 5 9-5V8M12 13v8"/></svg>
        Model
      </a>
      )}
      {!isAnonymous && (
      <a href="https://huggingface.co/datasets/AIGC-Research/ActCutBench" target="_blank" rel="noopener noreferrer" class={heroResourceClass}>
        <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 group-hover:scale-110 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 20V10m5 10V4m5 16v-7m5 7V8M2 20h20"/></svg>
        Benchmark
      </a>
      )}
    </div>

    {!isAnonymous && (
    <div class="glass-arch hero-logo-reveal -mx-2 flex w-[calc(100%+1rem)] flex-col items-stretch gap-y-3 rounded-2xl px-6 py-4 sm:-mx-4 sm:w-[calc(100%+2rem)] sm:rounded-3xl sm:px-8 sm:py-5 md:px-12 lg:grid lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] lg:items-center lg:gap-x-3 xl:gap-x-6" aria-label="Institution logos" data-reveal style="transition-delay:300ms">
      <div class="flex items-center justify-start">
        <img src={`${base}/images/siggraph-asia-2026-light.png`} class="block h-[80px] w-[210px] max-w-full object-contain xl:h-[88px] xl:w-[230px] dark:hidden" alt="SIGGRAPH Asia 2026" loading="eager" />
        <img src={`${base}/images/siggraph-asia-2026-dark.png`} class="hidden h-[80px] w-[210px] max-w-full object-contain xl:h-[88px] xl:w-[230px] dark:block" alt="SIGGRAPH Asia 2026" loading="eager" />
      </div>
      <div class="flex items-center justify-center">
        <img src={`${base}/images/aigc-research-light.png`} class="block h-[80px] w-[300px] max-w-full object-contain xl:h-[88px] xl:w-[330px] dark:hidden" alt="AIGC Research" loading="eager" />
        <img src={`${base}/images/aigc-research-dark.png`} class="hidden h-[80px] w-[300px] max-w-full object-contain xl:h-[88px] xl:w-[330px] dark:block" alt="AIGC Research" loading="eager" />
      </div>
      <div class="flex flex-wrap items-center justify-end gap-2 xl:gap-3">
        <img src={`${base}/images/teleai-logo.png`} class="h-[80px] w-[80px] object-contain xl:h-[88px] xl:w-[88px]" alt="TeleAI, Institute of Artificial Intelligence, China Telecom" loading="eager" />
        <img src={`${base}/images/fudan-university.png`} class="h-[80px] w-[80px] object-contain xl:h-[88px] xl:w-[88px]" alt="Fudan University" loading="eager" />
        <img src={`${base}/images/shanghaitech-university.svg`} class="h-[80px] w-[80px] object-contain xl:h-[88px] xl:w-[88px]" alt="ShanghaiTech University" loading="eager" />
      </div>
    </div>
    )}
  </div>
</header>

<!-- HERO VIDEO with letterbox + timecode -->
