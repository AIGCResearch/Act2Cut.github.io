---
// Real qualitative comparison: prompt → all methods discovered under /public/qualitative_comparison.
// The data file scans the directory and emits both `comparisonMethods` (rows) and
// `comparisonItems` (per-example videos keyed by method.key), so new methods appear
// automatically the next time the data file is regenerated.

import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';
import { comparisonItems, comparisonMethods } from '../data/comparisonData';
import DualVideo from './DualVideo.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

type CaptionJson = Record<string, string>;

const inputsDir = join(process.cwd(), 'public/qualitative_comparison/inputs');
let inputFiles: string[] = [];
try { inputFiles = readdirSync(inputsDir); } catch {}

function loadComparisonCaption(id: string): CaptionJson | null {
  const match = inputFiles.find(f => f.includes(id) && f.endsWith('_caption.json'));
  if (!match) return null;
  try { return JSON.parse(readFileSync(join(inputsDir, match), 'utf-8')); } catch { return null; }
}

const itemsWithCaptions = comparisonItems.map(item => ({
  ...item,
  captionData: loadComparisonCaption(item.id),
}));

const pages = [itemsWithCaptions];

const rows = comparisonMethods;
---

<section id="comparison" class="space-y-10">
  <!-- Section header -->
  <div data-reveal class="ambient-scrim">
    <div class="hero-content-divider mb-2" aria-hidden="true"></div>
    <span class="act-marker">ACT Ⅴ</span>
    <h2 class="text-3xl font-semibold tracking-tight flex items-center gap-3 mt-1 section-heading-float">
      <span class="inline-block w-1 h-7 bg-gradient-to-b from-[#ff4d4d] to-[#ffb84d] rounded-sm" style="transform: skewX(-6deg);"></span>
      Qualitative Comparison
    </h2>
    <p class="text-white/50 text-sm mt-2 section-heading-float">
      Same prompt, different models, text-to-video generation task
    </p>
  </div>


  <!-- Glass comparison table -->
  <div
    class="glass-table-card rounded-3xl overflow-hidden border border-white/[0.10] shadow-2xl"
    data-reveal
    style="transition-delay:120ms"
  >
    {pages.map((pageItems, pi) => (
      <div class={`bench-cmp-page ${pi !== 0 ? 'hidden' : ''}`} data-page={pi}>

        <!-- Column headers (one per example) -->
        <div
          class="grid border-b border-white/[0.08]"
          style={`grid-template-columns: 130px repeat(${pageItems.length}, 1fr)`}
        >
          <div class="px-3 sm:px-4 py-3 border-r border-white/[0.05] flex items-end">
            <span class="text-[8px] font-bold tracking-[0.28em] uppercase text-white/30">Model</span>
          </div>
          {pageItems.map((_item, idx) => (
            <div class="px-3 pt-3 pb-2.5 border-r border-white/[0.04] last:border-r-0 text-center">
              <div class="text-[11px] font-bold tracking-[0.10em] text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d] leading-tight">
                Case {_item.caseNumber}
              </div>
            </div>
          ))}
        </div>

        <!-- Model rows -->
        {rows.map((row, rowIdx) => (
          <div
            class:list={[
              'grid',
              rowIdx > 0 && 'border-t border-white/[0.06]',
              row.isOurs && 'bg-gradient-to-r from-[#ff4d4d]/[0.06] to-transparent',
            ]}
            style={`grid-template-columns: 130px repeat(${pageItems.length}, 1fr)`}
          >
            <div class="px-3 sm:px-4 py-2.5 flex items-center border-r border-white/[0.05]">
              <span class:list={[
                'text-[9.5px] font-bold tracking-[0.14em] uppercase',
                row.isOurs
                  ? 'text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d]'
                  : 'text-white/55',
              ]}>
                {row.label}
              </span>
            </div>

            {pageItems.map((item) => {
              const src = item.videos[row.key];
              return (
                <div class="p-1.5 sm:p-2 border-r border-white/[0.04] last:border-r-0" data-vid-tile>
                  <div
                    class:list={[
                      'qg-video-wrap cmp-card relative cinema-aspect rounded-lg overflow-hidden transition-all duration-300',
                      row.isOurs
                        ? 'bg-black/55 border border-[#ff4d4d]/30 hover:border-[#ff4d4d]/60'
                        : 'bg-black/55 border border-white/[0.08] hover:border-white/30',
                    ]}
                  >
                    {src ? (
                      <>
                        <DualVideo src={`${base}/${src}`} class="qg-video absolute inset-0 w-full h-full object-contain cursor-pointer" />
                        <div class="qg-scrub" data-scrub>
                          <div class="qg-scrub-fill"></div>
                          <div class="qg-scrub-thumb"></div>
                        </div>
                      </>
                    ) : (
                      <div class="absolute inset-0 flex flex-col items-center justify-center gap-1 text-white/25">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.4">
                          <circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8" stroke-dasharray="2 3"/>
                        </svg>
                        <span class="text-[8.5px] tracking-[0.20em] uppercase font-semibold">Not Available</span>
                      </div>
                    )}
                  </div>
                  {src && (
                    <div class="flex justify-center mt-1 mb-0.5">
                      <button class="vid-playbtn" data-playbtn type="button" aria-label="Toggle play/pause">
                        <svg class="icon-play w-2.5 h-2.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                        <svg class="icon-pause w-2.5 h-2.5" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                      </button>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        ))}

        <!-- Per-page prompts row (with hover/click popover for full per-shot prompts) -->
        <div
          class="grid border-t border-white/[0.06]"
          style={`grid-template-columns: 130px repeat(${pageItems.length}, 1fr)`}
        >
          <div class="px-3 sm:px-4 py-3 border-r border-white/[0.05] flex items-start">
            <span class="text-[8px] font-bold tracking-[0.28em] uppercase text-white/30">Prompt</span>
          </div>
          {pageItems.map((item) => {
            const cd = item.captionData;
            // Benchmark JSONs use global_caption + shot0/shot1 (0-indexed)
            // Gallery JSONs use global_setting/global_action/character1/shot1/shot1-2 (1-indexed)
            const isBenchmarkFmt = !!(cd && cd.global_caption);
            const charKeys = cd && !isBenchmarkFmt ? Object.keys(cd).filter(k => /^character\d+$/.test(k)) : [];
            const shotKeys = cd ? Object.keys(cd).filter(k => /^shot\d+$/.test(k)).sort() : [];
            const relKeys  = cd ? Object.keys(cd).filter(k => /^shot\d+-\d+$/.test(k)) : [];
            const summaryText = isBenchmarkFmt
              ? (cd!.global_caption ?? item.setting)
              : (cd?.global_setting?.replace(/^Global Setting:\s*/i, '') ?? item.setting);
            return (
              <div class="qg-prompt-block relative px-3 py-3 border-r border-white/[0.04] last:border-r-0 min-h-[120px]">
                <div class="flex items-center justify-between gap-2 mb-2 flex-wrap">
                  <span class="text-[9px] font-bold tracking-[0.16em] uppercase text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d]">
                    {item.numShots}-shot · {item.shots.join(' → ')}
                  </span>
                  <button
                    class="qg-prompt-toggle text-[8.5px] font-bold tracking-[0.16em] uppercase text-white/45 hover:text-[#ffb84d] transition-colors flex items-center gap-1"
                    type="button"
                    aria-expanded="false"
                  >
                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    All Prompts
                  </button>
                </div>
                <p class="qg-prompt-summary text-[10.5px] leading-relaxed text-white/65 font-light cursor-help line-clamp-3">
                  {summaryText}
                </p>

                <div class="qg-prompt-popover" role="dialog" aria-label="Full prompts">
                  <div class="qg-prompt-popover-inner">
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <span class="text-[9.5px] font-bold tracking-[0.20em] uppercase text-[#ffb84d]">Full Prompts</span>
                      <span class="text-[9px] text-white/40">{item.numShots} shots</span>
                    </div>
                    <div class="qg-prompt-list thin-scroll space-y-2">
                      {cd ? (
                        isBenchmarkFmt ? (
                          <>
                            {/* Benchmark format: global_caption + shot0, shot1... */}
                            <div class="space-y-1.5 pb-2 border-b border-white/[0.08]">
                              <p class="text-[10px] leading-relaxed text-white/75">
                                <span class="inline-block px-1.5 py-0.5 mr-1 mb-0.5 rounded bg-[#ff4d4d]/15 border border-[#ff4d4d]/25 font-mono text-[7.5px] tracking-[0.10em] text-[#ffb84d]">Global</span>
                                {cd.global_caption}
                              </p>
                            </div>
                            {shotKeys.length > 0 && (
                              <div class="space-y-1.5">
                                {shotKeys.map((k, ki) => (
                                  <p class="text-[10px] leading-relaxed text-white/75">
                                    <span class="inline-block px-1.5 py-0.5 mr-1 mb-0.5 rounded bg-white/[0.08] border border-white/10 font-mono text-[7.5px] tracking-[0.10em] text-white/65">Shot {ki + 1}</span>
                                    {cd[k]}
                                  </p>
                                ))}
                              </div>
                            )}
                          </>
                        ) : (
                          <>
                            {/* Gallery format: global_setting / global_action / characters / shots / relations */}
                            <div class="space-y-1.5 pb-2 border-b border-white/[0.08]">
                              {cd.global_setting && (
                                <p class="text-[10px] leading-relaxed text-white/75">
                                  <span class="inline-block px-1.5 py-0.5 mr-1 mb-0.5 rounded bg-[#ff4d4d]/15 border border-[#ff4d4d]/25 font-mono text-[7.5px] tracking-[0.10em] text-[#ffb84d]">Global Setting</span>
                                  {cd.global_setting.replace(/^Global Setting:\s*/i, '')}
                                </p>
                              )}
                              {cd.global_action && (
                                <p class="text-[10px] leading-relaxed text-white/75">
                                  <span class="inline-block px-1.5 py-0.5 mr-1 mb-0.5 rounded bg-[#ff4d4d]/15 border border-[#ff4d4d]/25 font-mono text-[7.5px] tracking-[0.10em] text-[#ffb84d]">Global Action</span>
                                  {cd.global_action.replace(/^Global Action\/Motion:\s*/i, '')}
                                </p>
                              )}
                              {charKeys.map(k => (
                                <p class="text-[10px] leading-relaxed text-white/75">
                                  <span class="inline-block px-1.5 py-0.5 mr-1 mb-0.5 rounded bg-white/[0.08] border border-white/10 font-mono text-[7.5px] tracking-[0.10em] text-white/65 capitalize">{k.replace('character', 'Character ')}</span>
                                  {(cd[k] ?? '').replace(/^\[character\d+\]\s+is\s+/i, '')}
                                </p>
                              ))}
                            </div>
                            {shotKeys.length > 0 && (
                              <div class="space-y-1.5 pb-2 border-b border-white/[0.08]">
                                {shotKeys.map((k, ki) => (
                                  <p class="text-[10px] leading-relaxed text-white/75">
                                    <span class="inline-block px-1.5 py-0.5 mr-1 mb-0.5 rounded bg-white/[0.08] border border-white/10 font-mono text-[7.5px] tracking-[0.10em] text-white/65">Shot {ki + 1}</span>
                                    {cd[k]}
                                  </p>
                                ))}
                              </div>
                            )}
                            {relKeys.length > 0 && (
                              <div class="space-y-1.5">
                                {relKeys.map(k => (
                                  <p class="text-[10px] leading-relaxed text-white/75">
                                    <span class="inline-block px-1.5 py-0.5 mr-1 mb-0.5 rounded bg-[#ffb84d]/10 border border-[#ffb84d]/20 font-mono text-[7.5px] tracking-[0.10em] text-[#ffb84d]/80">{k.replace('shot', 'Shot ').replace('-', ' → ')}</span>
                                    {cd[k]}
                                  </p>
                                ))}
                              </div>
                            )}
                          </>
                        )
                      ) : (
                        <ol class="space-y-2">
                          {item.fullPrompts.map((p, k) => (
                            <li class="text-[10px] leading-relaxed text-white/75">
                              <span class="inline-block px-1.5 py-0.5 mr-1 rounded bg-white/[0.08] border border-white/10 font-mono text-[7.5px] tracking-[0.10em] text-white/65">Shot {k + 1}</span>
                              {p}
                            </li>
                          ))}
                        </ol>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

      </div>
    ))}
  </div>
</section>

<script>
  // Pager wiring (unchanged behavior)
  function initBenchPager() {
    const bar = document.querySelector<HTMLElement>('[data-pager="bench-cmp"]');
    if (!bar) return;
    const pages = document.querySelectorAll<HTMLElement>('.bench-cmp-page');
    const dots  = bar.querySelectorAll<HTMLElement>('[data-pager-dot]');
    const prev  = bar.querySelector<HTMLButtonElement>('[data-pager-prev]');
    const next  = bar.querySelector<HTMLButtonElement>('[data-pager-next]');
    let cur = 0;

    function goTo(idx: number) {
      if (idx < 0 || idx >= pages.length) return;
      const oldP = pages[cur];
      const newP = pages[idx];
      cur = idx;

      oldP.style.transition = 'opacity 180ms ease';
      oldP.style.opacity = '0';
      setTimeout(() => {
        oldP.classList.add('hidden');
        oldP.style.opacity = '';
        oldP.style.transition = '';
        newP.classList.remove('hidden');
        newP.style.opacity = '0';
        requestAnimationFrame(() => requestAnimationFrame(() => {
          newP.style.transition = 'opacity 320ms cubic-bezier(0.22,1,0.36,1)';
          newP.style.opacity = '1';
          setTimeout(() => { newP.style.transition = ''; newP.style.opacity = ''; }, 350);
        }));
      }, 190);

      dots.forEach((d, i) => {
        if (i === idx) {
          d.classList.remove('w-1.5','h-1.5','bg-white/20','hover:bg-white/40');
          d.classList.add('w-4','h-1.5','bg-gradient-to-r','from-[#ff4d4d]','to-[#ffb84d]');
        } else {
          d.classList.remove('w-4','bg-gradient-to-r','from-[#ff4d4d]','to-[#ffb84d]');
          d.classList.add('w-1.5','h-1.5','bg-white/20','hover:bg-white/40');
        }
      });

      if (prev) prev.style.opacity = idx === 0 ? '0.25' : '1';
      if (next) next.style.opacity = idx === pages.length - 1 ? '0.25' : '1';
    }

    prev?.addEventListener('click', () => goTo(cur - 1));
    next?.addEventListener('click', () => goTo(cur + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));
    if (next) next.style.opacity = pages.length <= 1 ? '0.25' : '1';
    if (prev) prev.style.opacity = '0.25';
  }

  // Autoplay-on-scroll for every comparison tile + scrubber + prompt popovers, scoped to #comparison.
  function initComparisonInteractions() {
    const root = document.getElementById('comparison');
    if (!root) return;

    // Single IntersectionObserver for the whole table — videos play when on screen, pause when off.
    // The `_scrubbing` flag lets the user drag the timeline without the observer fighting them.
    const playObserver = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        const v = e.target as HTMLVideoElement;
        if ((v as any)._scrubbing) return;
        if ((v as any)._manualPause) return;
        if (e.isIntersecting) v.play().catch(() => {});
        else v.pause();
      });
    }, { threshold: 0.35 });
    root.querySelectorAll<HTMLVideoElement>('.cmp-card video.qg-video').forEach(v => playObserver.observe(v));

    // Scrubber
    root.querySelectorAll<HTMLElement>('.qg-video-wrap').forEach(wrap => {
      const video = wrap.querySelector<HTMLVideoElement>('video.qg-video');
      const scrub = wrap.querySelector<HTMLElement>('[data-scrub]');
      if (!video || !scrub) return;
      const fill  = scrub.querySelector<HTMLElement>('.qg-scrub-fill');
      const thumb = scrub.querySelector<HTMLElement>('.qg-scrub-thumb');
      if (!fill || !thumb) return;

      const update = () => {
        const d = video.duration;
        if (!d || !isFinite(d)) return;
        const pct = (video.currentTime / d) * 100;
        fill.style.width = pct + '%';
        thumb.style.left = pct + '%';
      };
      video.addEventListener('timeupdate', update);
      video.addEventListener('loadedmetadata', update);

      const seek = (clientX: number) => {
        const r = scrub.getBoundingClientRect();
        if (r.width <= 0) return;
        let p = (clientX - r.left) / r.width;
        p = Math.min(1, Math.max(0, p));
        if (video.duration && isFinite(video.duration)) {
          video.currentTime = p * video.duration;
          update();
        }
      };
      let dragging = false, wasPlaying = false;
      scrub.addEventListener('pointerdown', (e: PointerEvent) => {
        e.preventDefault();
        dragging = true;
        (video as any)._scrubbing = true;
        wasPlaying = !video.paused;
        video.pause();
        scrub.classList.add('is-dragging');
        scrub.setPointerCapture(e.pointerId);
        seek(e.clientX);
      });
      scrub.addEventListener('pointermove', (e: PointerEvent) => {
        if (dragging) seek(e.clientX);
      });
      const end = (e: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        (video as any)._scrubbing = false;
        scrub.classList.remove('is-dragging');
        try { scrub.releasePointerCapture(e.pointerId); } catch {}
        if (wasPlaying) video.play().catch(() => {});
      };
      scrub.addEventListener('pointerup', end);
      scrub.addEventListener('pointercancel', end);
    });

    // Play/pause buttons + click-on-video to toggle
    root.querySelectorAll<HTMLElement>('[data-vid-tile]').forEach(tile => {
      const video = tile.querySelector<HTMLVideoElement>('video.qg-video');
      const btn   = tile.querySelector<HTMLButtonElement>('[data-playbtn]');
      if (!video) return;

      function syncBtn() {
        if (!btn) return;
        if (video.paused) btn.classList.remove('is-playing');
        else              btn.classList.add('is-playing');
      }
      video.addEventListener('play',  syncBtn);
      video.addEventListener('pause', syncBtn);

      function toggle() {
        if (video.paused) {
          (video as any)._manualPause = false;
          video.play().catch(() => {});
        } else {
          (video as any)._manualPause = true;
          video.pause();
        }
      }
      btn?.addEventListener('click', toggle);
      video.addEventListener('click', () => {
        if ((video as any)._scrubbing) return;
        toggle();
      });
    });

    // Prompt popover toggles
    root.querySelectorAll<HTMLElement>('.qg-prompt-block').forEach(block => {
      const toggle = block.querySelector<HTMLButtonElement>('.qg-prompt-toggle');
      if (!toggle) return;
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const pinned = block.classList.toggle('is-pinned');
        toggle.setAttribute('aria-expanded', pinned ? 'true' : 'false');
      });
    });
    document.addEventListener('click', (e) => {
      root.querySelectorAll<HTMLElement>('.qg-prompt-block.is-pinned').forEach(block => {
        if (!block.contains(e.target as Node)) {
          block.classList.remove('is-pinned');
          block.querySelector('.qg-prompt-toggle')?.setAttribute('aria-expanded', 'false');
        }
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      root.querySelectorAll<HTMLElement>('.qg-prompt-block.is-pinned').forEach(block => {
        block.classList.remove('is-pinned');
        block.querySelector('.qg-prompt-toggle')?.setAttribute('aria-expanded', 'false');
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initBenchPager();
    initComparisonInteractions();
  });
</script>
