---
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const poster = `${base}/images/act2cut-sa-poster.png`;
---

<section id="poster" class="space-y-5 sm:space-y-6 scroll-mt-24">
  <div data-reveal class="ambient-scrim">
    <span class="act-marker">SIGGRAPH ASIA 2026</span>
    <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mt-1 section-heading-float">Poster</h2>
  </div>

  <div class="glass-arch mx-auto grid max-w-5xl grid-cols-1 items-center gap-6 rounded-2xl p-4 sm:gap-8 sm:rounded-3xl sm:p-7 lg:grid-cols-[minmax(0,400px)_1fr] lg:gap-10" data-reveal>
    <a href={poster} target="_blank" rel="noopener" aria-label="Open the full-size Act2Cut poster in a new tab" class="block overflow-hidden rounded-xl border border-white/20 transition-transform duration-300 hover:scale-[1.01] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#ffb84d]">
      <img
        src={poster}
        alt="Act2Cut SIGGRAPH Asia 2026 poster, summarizing the Action-Cut problem, prompt structure, dataset, architecture, and results"
        width="1649"
        height="2363"
        loading="lazy"
        decoding="async"
        class="block h-auto w-full"
      />
    </a>

    <div class="space-y-5 sm:space-y-6">
      <div class="space-y-3">
        <p class="text-[10px] font-bold uppercase tracking-[0.24em] text-[#ffb84d]">One Action · Multiple Views</p>
        <h3 class="text-xl font-semibold text-white sm:text-2xl">Act2Cut at a glance</h3>
        <p class="max-w-md text-sm leading-relaxed text-white/60">The conference poster brings together the Action-Cut problem, prompt design, dataset, architecture, and results on one page.</p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a href={poster} target="_blank" rel="noopener" class="inline-flex items-center justify-center rounded-full border border-[#ffb84d]/45 bg-[#ffb84d]/15 px-5 py-2.5 text-xs font-semibold text-white transition-colors hover:bg-[#ffb84d]/25">View full-size poster</a>
        <a href={poster} download="Act2Cut_SA_poster.png" class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/[0.05] px-5 py-2.5 text-xs font-semibold text-white/75 transition-colors hover:bg-white/[0.1] hover:text-white">Download PNG</a>
      </div>
      <p class="text-xs text-white/40">Click the image to open the original resolution.</p>
    </div>
  </div>
</section>
