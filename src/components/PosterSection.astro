---
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const poster = `${base}/images/act2cut-sa-poster.png`;
const siggraphMark = `${base}/images/siggraph-asia-mark.png`;
---

<section id="poster" class="space-y-5 sm:space-y-6 scroll-mt-24">
  <div data-reveal class="ambient-scrim text-center">
    <div class="hero-content-divider mb-2" aria-hidden="true"></div>
    <span class="act-marker">SIGGRAPH ASIA 2026</span>
    <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mt-1 section-heading-float">Presentation &amp; Poster</h2>
  </div>

  <div class="glass-arch relative mx-auto grid max-w-5xl grid-cols-1 items-center gap-6 rounded-2xl p-4 sm:gap-8 sm:rounded-3xl sm:p-7 lg:grid-cols-[minmax(0,400px)_1fr] lg:gap-10" data-reveal>
    <a href={poster} target="_blank" rel="noopener" aria-label="Open the full-size Act2Cut poster in a new tab" class="block overflow-hidden rounded-xl border border-white/20 transition-transform duration-300 hover:scale-[1.01] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#ffb84d]">
      <img
        src={poster}
        alt="Act2Cut SIGGRAPH Asia 2026 poster, summarizing the Action-Cut problem, prompt structure, dataset, architecture, and results"
        width="1649"
        height="2363"
        loading="lazy"
        decoding="async"
        class="block h-auto w-full"
      />
    </a>

    <div class="relative isolate">
      <img src={siggraphMark} alt="" aria-hidden="true" width="391" height="391" loading="lazy" decoding="async" class="pointer-events-none absolute left-1/2 top-1/2 z-0 w-full max-w-none -translate-x-1/2 -translate-y-1/2 opacity-[0.14] dark:opacity-[0.18]" />
      <div class="relative z-10 space-y-5 sm:space-y-6">
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <p class="poster-kicker bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d] bg-clip-text text-[10px] font-bold uppercase tracking-[0.24em] text-transparent">One Action · Multiple Views</p>
            <span class="poster-series-badge pointer-events-none relative shrink-0 rounded-full border border-[#ffb84d]/40 bg-[#ffb84d]/12 bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d] bg-clip-text px-3 py-1 text-xs font-semibold tracking-[0.12em] text-transparent backdrop-blur-md">ActXCut series</span>
          </div>
          <h3 class="text-xl font-semibold text-white sm:text-2xl">Act2Cut @ SIGGRAPH Asia 2026</h3>
          <div class="max-w-lg space-y-2 text-sm leading-relaxed text-white/70">
            <p class="font-semibold text-white/90">🔥 Conference Schedule Details:</p>
            <p><span aria-hidden="true" class="mr-1.5">🎬</span><strong class="font-semibold text-white/85">Title:</strong> Act2Cut: Continuous Multi-Shot Video Narrative Match on Action-Cut (papers_1174s4)</p>
            <p><span aria-hidden="true" class="mr-1.5">🎞️</span><strong class="font-semibold text-white/85">Session:</strong> Directing the Video</p>
            <p><span aria-hidden="true" class="mr-1.5">🕒</span><strong class="font-semibold text-white/85">Time:</strong> Wed, Dec 02 | 4:30 PM – 5:35 PM</p>
            <p><span aria-hidden="true" class="mr-1.5">📍</span><strong class="font-semibold text-white/85">Location:</strong> Conference Hall 1, Level 3, Kuala Lumpur Convention Centre (KLCC)</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-3">
          <a href={poster} target="_blank" rel="noopener" class="inline-flex items-center justify-center rounded-full border border-[#ffb84d]/45 bg-[#ffb84d]/15 px-5 py-2.5 text-xs font-semibold text-white transition-colors hover:bg-[#ffb84d]/25">View full-size poster</a>
          <a href={poster} download="Act2Cut_SA_poster.png" class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/[0.05] px-5 py-2.5 text-xs font-semibold text-white/75 transition-colors hover:bg-white/[0.1] hover:text-white">Download PNG</a>
        </div>
        <p class="text-xs text-white/40">Click the image to open the original resolution.</p>
      </div>
    </div>
  </div>
</section>
