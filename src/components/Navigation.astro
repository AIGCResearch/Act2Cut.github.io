---
import MusicToggle from './MusicToggle.astro';

interface Props {
  page?: 'home' | 'dataset' | 'benchmark';
}
const { page = 'home' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const url  = (p: string) => `${base}${p}`;

const homeAnchors = [
  { label: 'Abstract',      href: url('/#abstract') },
  { label: 'Definition',    href: url('/#problem-definition') },
  { label: 'Dataset',       href: url('/#dataset-curation') },
  { label: 'Model',         href: url('/#model-architecture') },
  { label: 'Experiment',    href: url('/#results')  },
  ...(import.meta.env.BUILD_MODE === 'anonymous' ? [] : [{ label: 'Cite', href: url('/#citation') }]),
];

const pageLinks = [
  { id: 'home',      label: 'Home',      href: url('/') },
  { id: 'dataset',   label: 'Dataset',   href: url('/dataset'),   hint: 'ActCutVid-1M' },
  { id: 'benchmark', label: 'Benchmark', href: url('/benchmark'), hint: 'ActCutBench' },
];
---

<!-- Full-width navigation at the top; floating island after scrolling -->
<header
  id="top-nav"
  class="fixed z-50 nav-with-music"
>
  <div class="nav-glass relative">
    <div class="nav-row relative max-w-[1440px] mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">

      <!-- Brand — typographic wordmark, no icon -->
      <a href={url('/')} class="brand-mark group flex items-baseline gap-0.5 shrink-0 select-none" aria-label="Act2Cut — Home">
        <span class="font-semibold text-[20px] sm:text-[22px] tracking-tight text-white/95 leading-none">Act</span>
        <span class="brand-two relative font-bold text-[22px] sm:text-[24px] not-italic leading-none -mx-[1px] text-transparent bg-clip-text bg-gradient-to-br from-[#ff4d4d] via-[#ff7a3d] to-[#ffb84d]">
          2
          <!-- subtle cut-line accent -->
          <span class="brand-cut absolute -left-0.5 right-0 -bottom-0.5 h-px bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d] origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]" aria-hidden="true"></span>
        </span>
        <span class="font-semibold text-[20px] sm:text-[22px] tracking-tight text-white/95 leading-none">Cut</span>
        <!-- micro tagline -->
        <span class="brand-tagline relative inline-block ml-1.5 sm:ml-2.5 self-center text-[7px] sm:text-[10px] tracking-[0.18em] sm:tracking-[0.32em] uppercase text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d] font-semibold pl-1.5 sm:pl-2.5">Match&nbsp;on<br class="md:hidden" /><span class="hidden md:inline">&nbsp;</span>Action</span>
      </a>

      <!-- Center: page nav (desktop) — absolutely centered so position never shifts between pages -->
      <nav class="primary-nav hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 items-center gap-1 p-1 rounded-full border border-white/[0.08] bg-white/[0.03] backdrop-blur-xl pointer-events-auto" aria-label="Primary">
        {pageLinks.map(link => (
          <div class="nav-page-item group relative">
            <a
              href={link.href}
              aria-describedby={link.hint ? `nav-hint-${link.id}` : undefined}
              class:list={[
                'relative block px-4 py-1.5 rounded-full text-[11px] font-bold tracking-[0.18em] uppercase transition-all duration-300',
                page === link.id
                  ? 'text-black bg-white shadow-[0_2px_14px_rgba(255,255,255,0.18)]'
                  : 'text-white/55 hover:text-white/90 hover:bg-white/[0.05]',
              ]}
            >
              {link.label}
            </a>
            {link.hint && (
              <span id={`nav-hint-${link.id}`} role="tooltip" class="nav-hover-hint pointer-events-none absolute left-1/2 top-[calc(100%+0.65rem)] z-20 -translate-x-1/2 translate-y-1 scale-95 whitespace-nowrap rounded-full px-3 py-1.5 text-[10px] font-semibold tracking-[0.08em] opacity-0 shadow-[0_8px_22px_rgba(0,0,0,0.3)] transition-[opacity,transform] duration-200 group-hover:translate-y-0 group-hover:scale-100 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:scale-100 group-focus-within:opacity-100">
                {link.hint}
              </span>
            )}
          </div>
        ))}
      </nav>

      <!-- Partner marks on compact navigation -->
      <div class="mobile-partner-marks md:hidden ml-auto flex shrink-0 items-center gap-1">
        <a
          href="https://aigcresearch.github.io/"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-aigc-mark flex h-8 w-8 items-center justify-center rounded-full opacity-80 transition-opacity duration-200 hover:opacity-100"
          aria-label="AIGC Research"
        >
          <img src={`${base}/images/aigc-research-mark-light.png`} class="block h-7 w-7 object-contain dark:hidden" alt="AIGC Research" loading="eager" />
          <img src={`${base}/images/aigc-research-mark-dark.png`} class="hidden h-7 w-7 object-contain dark:block" alt="AIGC Research" loading="eager" />
        </a>
        <a
          href={url('/#poster')}
          class="mobile-siga-mark flex h-8 w-8 items-center justify-center rounded-full opacity-80 transition-opacity duration-200 hover:opacity-100"
          aria-label="SIGGRAPH Asia 2026 Poster"
        >
          <img src={`${base}/images/siggraph-asia-mark.png`} class="h-7 w-7 object-contain" alt="SIGGRAPH Asia" loading="eager" />
        </a>
      </div>

      <!-- Right: anchor links and media controls -->
      <div class="flex items-center gap-2 max-[400px]:gap-1 shrink-0">

        <!-- Home anchors only on home page (desktop) -->
        {page === 'home' && (
          <nav id="top-section-links" class="top-section-links hidden min-[1360px]:flex items-center gap-0.5 mr-1" aria-label="On-page sections">
            {homeAnchors.map(link => (
              <a
                href={link.href}
                data-nav-link
                class="nav-link px-2.5 py-1.5 rounded-xl text-[13px] font-semibold tracking-[0.02em] text-white/40 hover:text-white/85 hover:bg-white/[0.05] transition-all duration-200"
              >
                {link.label}
              </a>
            ))}
          </nav>
        )}

        <!-- Partner marks appear to the left of Sections when floating -->
        <a
          href="https://aigcresearch.github.io/"
          target="_blank"
          rel="noopener noreferrer"
          class="desktop-aigc-mark flex h-9 w-9 shrink-0 items-center justify-center rounded-full"
          aria-label="AIGC Research"
        >
          <img src={`${base}/images/aigc-research-mark-light.png`} class="block h-8 w-8 object-contain dark:hidden" alt="AIGC Research" loading="eager" />
          <img src={`${base}/images/aigc-research-mark-dark.png`} class="hidden h-8 w-8 object-contain dark:block" alt="AIGC Research" loading="eager" />
        </a>
        <a
          href={url('/#poster')}
          class="desktop-siga-mark flex h-9 w-9 shrink-0 items-center justify-center rounded-full"
          aria-label="SIGGRAPH Asia 2026 Poster"
        >
          <img src={`${base}/images/siggraph-asia-mark.png`} class="h-8 w-8 object-contain" alt="SIGGRAPH Asia" loading="eager" />
        </a>

        {page === 'home' && (
          <div id="section-dropdown" class="section-dropdown relative">
            <button
              id="section-menu-toggle"
              type="button"
              aria-label="Show page sections"
              aria-controls="section-menu"
              aria-expanded="false"
              class="flex items-center gap-1.5 px-2 py-2 rounded-xl border border-white/[0.1] bg-white/[0.04] text-[12px] font-semibold tracking-[0.04em] text-white/65 hover:text-white/90 hover:bg-white/[0.09] transition-colors"
            >
              Sections
              <svg class="section-chevron w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6" />
              </svg>
            </button>
            <nav id="section-menu" class="absolute right-0 top-[calc(100%+10px)] w-56 rounded-2xl border border-white/20 bg-[#0a0a0a] p-2 shadow-[0_14px_38px_rgba(0,0,0,0.38)] backdrop-blur-xl" aria-label="On-page sections" aria-hidden="true" inert>
              {homeAnchors.map(link => (
                <a href={link.href} data-nav-link class="section-menu-link block rounded-xl px-3 py-2.5 text-[13px] font-semibold tracking-[0.03em] transition-colors">
                  {link.label}
                </a>
              ))}
            </nav>
          </div>
        )}

        <div id="nav-controls" class="flex shrink-0 items-center gap-1 md:gap-2">
          <MusicToggle />
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle light/dark mode"
            title="Toggle light/dark mode"
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-white/[0.1] bg-white/[0.04] text-white/45 transition-all duration-200 hover:border-white/30 hover:bg-white/[0.09] hover:text-white/80"
          >
            <svg class="theme-icon-dark w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
            </svg>
            <svg class="theme-icon-light w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
          </button>
        </div>

        <!-- Hamburger (mobile) -->
        <button
          id="nav-hamburger"
          aria-label="Open menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
          class="md:hidden w-9 h-9 max-[400px]:h-8 max-[400px]:w-8 rounded-xl border border-white/[0.1] hover:border-white/30 bg-white/[0.04] hover:bg-white/[0.09] flex items-center justify-center text-white/55 hover:text-white/85 transition-all duration-200"
        >
          <svg id="hamburger-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 13h16M4 19h16"/>
          </svg>
          <svg id="close-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>

      </div>
    </div>

    <!-- Mobile dropdown -->
    <div
      id="mobile-menu"
      class="md:hidden hidden overflow-x-hidden overflow-y-auto overscroll-contain"
      inert
    >
      <div class="max-w-6xl mx-auto px-4 py-3 flex flex-col gap-1">
        <div id="mobile-music-control" class="hidden max-[350px]:flex justify-end px-3 pb-2"></div>
        <div class="text-[8.5px] font-bold tracking-[0.32em] uppercase text-white/30 px-3 pb-2 pt-1">Pages</div>
        {pageLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'mobile-nav-link group flex items-center justify-between px-3 py-3 rounded-xl text-[12px] font-bold tracking-[0.14em] uppercase transition-all duration-200',
              page === link.id
                ? 'mobile-nav-current border'
                : 'text-white/65 hover:text-white border border-transparent hover:bg-white/[0.05] hover:border-white/[0.08]',
            ]}
          >
            <span>{link.label}</span>
            <svg class="w-3.5 h-3.5 opacity-50 group-hover:opacity-90 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        ))}

        {page === 'home' && (
          <>
            <div class="text-[8.5px] font-bold tracking-[0.12em] text-white/30 px-3 pt-3 pb-1">On this page</div>
            {homeAnchors.map(link => (
              <a
                href={link.href}
                data-nav-link
                class="mobile-nav-link px-3 py-2.5 rounded-lg text-[14px] font-semibold tracking-[0.03em] text-white/55 hover:text-white hover:bg-white/[0.05] transition-all duration-200"
              >
                {link.label}
              </a>
            ))}
          </>
        )}
      </div>
    </div>
  </div>
</header>

<!-- Spacer so content doesn't hide under fixed nav -->
<div class="h-16"></div>

<script>
  // ── Theme toggle ──────────────────────────────────────────────────────────
  function isDark() { return document.documentElement.classList.contains('dark'); }

  function syncUI() {
    const dark = isDark();
    document.querySelectorAll<HTMLElement>('.theme-icon-dark').forEach(el => el.classList.toggle('hidden', !dark));
    document.querySelectorAll<HTMLElement>('.theme-icon-light').forEach(el => el.classList.toggle('hidden', dark));
  }

  let heroInkFrame: number | null = null;
  function syncHeroTitleInk() {
    const title = document.getElementById('hero-title');
    const icon = document.querySelector<SVGElement>('.hero-resource-group a:not(:hover) svg')
      ?? document.querySelector<SVGElement>('.hero-resource-group a svg');
    if (!title || !icon) return;

    if (heroInkFrame !== null) cancelAnimationFrame(heroInkFrame);
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      title.style.setProperty('--hero-title-ink', isDark() ? '#ededed' : '#0f0c0a');
      heroInkFrame = null;
      return;
    }

    const started = performance.now();
    const sampleIcon = () => {
      title.style.setProperty('--hero-title-ink', getComputedStyle(icon).color);
      heroInkFrame = performance.now() - started < 1200 ? requestAnimationFrame(sampleIcon) : null;
    };
    sampleIcon();
  }

  function toggleTheme() {
    const html = document.documentElement;
    if (isDark()) { html.classList.remove('dark'); localStorage.setItem('theme', 'light'); }
    else          { html.classList.add('dark');    localStorage.setItem('theme', 'dark');  }
    syncUI();
    syncHeroTitleInk();
  }

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  syncUI();

  // ── Hamburger menu ────────────────────────────────────────────────────────
  const hamburger     = document.getElementById('nav-hamburger');
  const mobileMenu    = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon     = document.getElementById('close-icon');
  let mobileMenuCloseTimer: number | undefined;

  function setMobileMenu(open: boolean) {
    if (!mobileMenu || !hamburger) return;
    window.clearTimeout(mobileMenuCloseTimer);
    hamburger.setAttribute('aria-expanded', String(open));
    hamburger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    mobileMenu.toggleAttribute('inert', !open);
    if (open) {
      mobileMenu.classList.remove('hidden');
      // Animate open
      mobileMenu.style.maxHeight = '0px';
      mobileMenu.style.opacity = '0';
      requestAnimationFrame(() => requestAnimationFrame(() => {
        if (hamburger.getAttribute('aria-expanded') !== 'true') return;
        mobileMenu.style.transition = 'max-height 320ms cubic-bezier(0.22,1,0.36,1), opacity 260ms ease';
        mobileMenu.style.maxHeight = `min(${mobileMenu.scrollHeight}px, calc(100dvh - 5.75rem))`;
        mobileMenu.style.opacity = '1';
      }));
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      mobileMenu.style.transition = 'max-height 240ms ease, opacity 180ms ease';
      mobileMenu.style.maxHeight = '0px';
      mobileMenu.style.opacity = '0';
      mobileMenuCloseTimer = window.setTimeout(() => {
        mobileMenu.classList.add('hidden');
        mobileMenu.style.transition = '';
        mobileMenu.style.maxHeight = '';
        mobileMenu.style.opacity = '';
      }, 250);
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  }

  const navControls = document.getElementById('nav-controls');
  const mobileMusic = document.getElementById('mobile-music-control');
  const musicToggle = document.getElementById('music-toggle');
  if (navControls && mobileMusic && musicToggle) {
    const narrowNav = window.matchMedia('(max-width: 350px)');
    const placeMusic = () => {
      if (narrowNav.matches) mobileMusic.append(musicToggle);
      else navControls.prepend(musicToggle);
    };
    narrowNav.addEventListener('change', placeMusic);
    placeMusic();
  }
  const wideNav = window.matchMedia('(min-width: 768px)');
  wideNav.addEventListener('change', event => {
    if (event.matches && hamburger?.getAttribute('aria-expanded') === 'true') setMobileMenu(false);
  });

  hamburger?.addEventListener('click', () => {
    const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
    setMobileMenu(!isOpen);
  });

  document.addEventListener('click', event => {
    if (hamburger?.getAttribute('aria-expanded') !== 'true') return;
    const target = event.target;
    if (target instanceof Node && !mobileMenu?.contains(target) && !hamburger.contains(target)) {
      setMobileMenu(false);
    }
  });
  const closeMobileMenuOnTouchOutside = (event: TouchEvent) => {
    if (hamburger?.getAttribute('aria-expanded') !== 'true') return;
    const touch = event.touches[0] ?? event.changedTouches[0];
    const target = touch ? document.elementFromPoint(touch.clientX, touch.clientY) : event.target;
    if (!(target instanceof Node) || (!mobileMenu?.contains(target) && !hamburger?.contains(target))) {
      setMobileMenu(false);
    }
  };
  document.addEventListener('touchstart', closeMobileMenuOnTouchOutside, { passive: true });
  document.addEventListener('touchmove', closeMobileMenuOnTouchOutside, { passive: true });

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => setMobileMenu(false));
  });

  // ── Scrolled section dropdown ────────────────────────────────────────────
  const sectionDropdown = document.getElementById('section-dropdown');
  const sectionToggle = document.getElementById('section-menu-toggle');
  const sectionMenu = document.getElementById('section-menu');
  const topSectionLinks = document.getElementById('top-section-links');
  const sectionDropdownMedia = window.matchMedia('(min-width: 768px)');
  let sectionOpenTimer: number | undefined;
  let sectionCloseTimer: number | undefined;
  let sectionHoverOpen = false;

  function scheduleSectionClose() {
    window.clearTimeout(sectionCloseTimer);
    sectionCloseTimer = window.setTimeout(() => {
      setSectionMenu(false);
    }, 1000);
  }

  function scheduleHoverSectionClose() {
    window.clearTimeout(sectionCloseTimer);
    sectionCloseTimer = window.setTimeout(() => {
      if (!sectionHoverOpen) setSectionMenu(false);
    }, 260);
  }

  function setSectionMenu(open: boolean) {
    if (!sectionToggle || !sectionMenu) return;
    if (!open) window.clearTimeout(sectionCloseTimer);
    sectionToggle.setAttribute('aria-expanded', String(open));
    sectionMenu.setAttribute('aria-hidden', String(!open));
    sectionMenu.toggleAttribute('inert', !open);
  }

  sectionToggle?.addEventListener('click', () => {
    window.clearTimeout(sectionOpenTimer);
    const open = sectionToggle.getAttribute('aria-expanded') !== 'true';
    setSectionMenu(open);
  });
  sectionDropdown?.addEventListener('pointerenter', event => {
    if (event.pointerType !== 'mouse' || !sectionDropdownMedia.matches) return;
    if (!document.getElementById('top-nav')?.classList.contains('nav-scrolled')) return;
    sectionHoverOpen = true;
    window.clearTimeout(sectionCloseTimer);
    setSectionMenu(true);
  });
  sectionDropdown?.addEventListener('mouseleave', () => {
    if (!sectionHoverOpen) return;
    sectionHoverOpen = false;
    scheduleHoverSectionClose();
  });
  sectionMenu?.addEventListener('mouseenter', () => {
    sectionHoverOpen = true;
    window.clearTimeout(sectionCloseTimer);
    setSectionMenu(true);
  });
  sectionMenu?.addEventListener('mouseleave', () => {
    sectionHoverOpen = false;
    scheduleHoverSectionClose();
  });
  sectionMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => setSectionMenu(false));
  });
  document.addEventListener('click', event => {
    if (sectionDropdown && !sectionDropdown.contains(event.target as Node)) setSectionMenu(false);
  });
  const closeSectionOnTouchOutside = (event: TouchEvent) => {
    if (sectionToggle?.getAttribute('aria-expanded') !== 'true') return;
    const touch = event.touches[0] ?? event.changedTouches[0];
    const target = touch ? document.elementFromPoint(touch.clientX, touch.clientY) : event.target;
    if (!(target instanceof Node) || !sectionDropdown?.contains(target)) setSectionMenu(false);
  };
  document.addEventListener('touchstart', closeSectionOnTouchOutside, { passive: true });
  document.addEventListener('touchmove', closeSectionOnTouchOutside, { passive: true });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && sectionToggle?.getAttribute('aria-expanded') === 'true') {
      setSectionMenu(false);
      sectionToggle.focus();
    }
  });
  sectionDropdownMedia.addEventListener('change', event => {
    window.clearTimeout(sectionOpenTimer);
    const open = event.matches && document.getElementById('top-nav')?.classList.contains('nav-scrolled') === true;
    setSectionMenu(open);
    if (open) scheduleSectionClose();
  });

  // ── Scroll spy (homepage anchor links) ───────────────────────────────────
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

  if (navLinks.length > 0) {
    // Collect IDs referenced by nav links (works for both section and div targets).
    const targetIds = Array.from(navLinks)
      .map(l => (l.getAttribute('href') || '').split('#')[1])
      .filter(Boolean);

    function updateScrollSpy() {
      const threshold = window.innerHeight * 0.45;
      let activeId = '';
      let bestTop = -Infinity;
      targetIds.forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        const top = el.getBoundingClientRect().top;
        if (top <= threshold && top > bestTop) { bestTop = top; activeId = id; }
      });
      navLinks.forEach(link => {
        const href = link.getAttribute('href') || '';
        const active = activeId !== '' && href.endsWith(`#${activeId}`);
        link.classList.toggle('text-white/85', active);
        link.classList.toggle('bg-white/[0.05]', active);
        link.classList.toggle('text-white/40', !active);
      });
    }

    window.addEventListener('scroll', updateScrollSpy, { passive: true });
    updateScrollSpy();
  }

  // ── Scroll shadow on nav ──────────────────────────────────────────────────
  const header = document.getElementById('top-nav');
  function onScroll() {
    const scrolled = window.scrollY > 8;
    const wasScrolled = header?.classList.contains('nav-scrolled') ?? false;
    header?.classList.toggle('nav-scrolled', scrolled);
    document.documentElement.classList.toggle('nav-scrolled', scrolled);
    topSectionLinks?.toggleAttribute('inert', scrolled);
    topSectionLinks?.setAttribute('aria-hidden', String(scrolled));
    if (scrolled !== wasScrolled) {
      window.clearTimeout(sectionOpenTimer);
      if (scrolled && sectionDropdownMedia.matches) {
        // Open the list as the horizontal links finish moving into the trigger.
        sectionOpenTimer = window.setTimeout(() => {
          if (header?.classList.contains('nav-scrolled')) {
            setSectionMenu(true);
            scheduleSectionClose();
          }
        }, 280);
      } else {
        setSectionMenu(false);
      }
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  #top-nav {
    top: 0;
    left: 50%;
    width: 100%;
    max-width: 100vw;
    transform: translateX(-50%);
    transition: top 320ms ease, width 320ms ease, max-width 320ms ease;
  }
  #top-nav.nav-scrolled {
    top: 12px;
    width: calc(100% - 48px);
    max-width: 880px;
  }
  #top-nav.nav-with-music.nav-scrolled {
    max-width: 975px;
  }
  #top-nav .nav-glass {
    position: relative;
    isolation: isolate;
