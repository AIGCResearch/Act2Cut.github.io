---
interface Props {
  page?: 'home' | 'dataset' | 'benchmark';
}
const { page = 'home' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const url  = (p: string) => `${base}${p}`;

const homeAnchors = [
  { label: 'Abstract', href: url('/#abstract') },
  { label: 'Method',   href: url('/#overview') },
  { label: 'Results',  href: url('/#results')  },
  { label: 'Ablation', href: url('/#ablation') },
];

const pageLinks = [
  { id: 'home',      label: 'Home',      href: url('/') },
  { id: 'dataset',   label: 'Dataset',   href: url('/dataset') },
  { id: 'benchmark', label: 'Benchmark', href: url('/benchmark') },
];
---

<!-- Full-width navigation at the top; floating island after scrolling -->
<header
  id="top-nav"
  class="fixed z-50"
>
  <div class="nav-glass relative">
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">

      <!-- Brand — typographic wordmark, no icon -->
      <a href={url('/')} class="brand-mark group flex items-baseline gap-0.5 shrink-0 select-none" aria-label="Act2Cut — Home">
        <span class="font-semibold text-[20px] sm:text-[22px] tracking-tight text-white/95 leading-none">Act</span>
        <span class="brand-two relative font-bold text-[22px] sm:text-[24px] not-italic leading-none -mx-[1px] text-transparent bg-clip-text bg-gradient-to-br from-[#ff4d4d] via-[#ff7a3d] to-[#ffb84d]">
          2
          <!-- subtle cut-line accent -->
          <span class="brand-cut absolute -left-0.5 right-0 -bottom-0.5 h-px bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d] origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]" aria-hidden="true"></span>
        </span>
        <span class="font-semibold text-[20px] sm:text-[22px] tracking-tight text-white/95 leading-none">Cut</span>
        <!-- micro tagline -->
        <span class="brand-tagline hidden sm:inline-block ml-2.5 self-center text-[8.5px] tracking-[0.32em] uppercase text-white/30 font-semibold border-l border-white/15 pl-2.5">Match&nbsp;on&nbsp;Action</span>
      </a>

      <!-- Center: page nav (desktop) — absolutely centered so position never shifts between pages -->
      <nav class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 items-center gap-1 p-1 rounded-full border border-white/[0.08] bg-white/[0.03] backdrop-blur-xl pointer-events-auto" aria-label="Primary">
        {pageLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'relative px-4 py-1.5 rounded-full text-[11px] font-bold tracking-[0.18em] uppercase transition-all duration-300',
              page === link.id
                ? 'text-black bg-white shadow-[0_2px_14px_rgba(255,255,255,0.18)]'
                : 'text-white/55 hover:text-white/90 hover:bg-white/[0.05]',
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right: anchor links + theme toggle -->
      <div class="flex items-center gap-2 shrink-0">

        <!-- Home anchors only on home page (desktop) -->
        {page === 'home' && (
          <nav id="top-section-links" class="top-section-links hidden lg:flex items-center gap-0.5 mr-1" aria-label="On-page sections">
            {homeAnchors.map(link => (
              <a
                href={link.href}
                data-nav-link
                class="nav-link px-2.5 py-1.5 rounded-md text-[10px] font-semibold tracking-[0.16em] uppercase text-white/40 hover:text-white/85 hover:bg-white/[0.05] transition-all duration-200"
              >
                {link.label}
              </a>
            ))}
          </nav>
        )}

        {page === 'home' && (
          <div id="section-dropdown" class="section-dropdown relative">
            <button
              id="section-menu-toggle"
              type="button"
              aria-label="Show page sections"
              aria-controls="section-menu"
              aria-expanded="false"
              class="flex items-center gap-2 px-3 py-2 rounded-xl border border-white/[0.1] bg-white/[0.04] text-[10px] font-semibold tracking-[0.16em] uppercase text-white/65 hover:text-white/90 hover:bg-white/[0.09] transition-colors"
            >
              Sections
              <svg class="section-chevron w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6" />
              </svg>
            </button>
            <nav id="section-menu" class="absolute right-0 top-[calc(100%+10px)] w-48 rounded-2xl border border-white/20 bg-[#0a0a0a] p-2 shadow-[0_14px_38px_rgba(0,0,0,0.38)] backdrop-blur-xl" aria-label="On-page sections" aria-hidden="true" inert>
              {homeAnchors.map(link => (
                <a href={link.href} data-nav-link class="section-menu-link block rounded-xl px-3 py-2.5 text-[11px] font-semibold tracking-[0.14em] uppercase transition-colors">
                  {link.label}
                </a>
              ))}
            </nav>
          </div>
        )}

        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          aria-label="Toggle light/dark mode"
          class="w-9 h-9 rounded-xl border border-white/[0.1] hover:border-white/30 bg-white/[0.04] hover:bg-white/[0.09] flex items-center justify-center text-white/45 hover:text-white/80 transition-all duration-200 shrink-0"
        >
          <svg class="theme-icon-dark w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
          <svg class="theme-icon-light w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
        </button>

        <!-- Hamburger (mobile) -->
        <button
          id="nav-hamburger"
          aria-label="Open menu"
          aria-expanded="false"
          class="md:hidden w-9 h-9 rounded-xl border border-white/[0.1] hover:border-white/30 bg-white/[0.04] hover:bg-white/[0.09] flex items-center justify-center text-white/55 hover:text-white/85 transition-all duration-200"
        >
          <svg id="hamburger-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 13h16M4 19h16"/>
          </svg>
          <svg id="close-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>

      </div>
    </div>

    <!-- Mobile dropdown -->
    <div
      id="mobile-menu"
      class="md:hidden hidden overflow-hidden"
    >
      <div class="max-w-6xl mx-auto px-4 py-3 flex flex-col gap-1">
        <div class="text-[8.5px] font-bold tracking-[0.32em] uppercase text-white/30 px-3 pb-2 pt-1">Pages</div>
        {pageLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'mobile-nav-link group flex items-center justify-between px-3 py-3 rounded-xl text-[12px] font-bold tracking-[0.14em] uppercase transition-all duration-200',
              page === link.id
                ? 'mobile-nav-current border'
                : 'text-white/65 hover:text-white border border-transparent hover:bg-white/[0.05] hover:border-white/[0.08]',
            ]}
          >
            <span>{link.label}</span>
            <svg class="w-3.5 h-3.5 opacity-50 group-hover:opacity-90 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        ))}

        {page === 'home' && (
          <>
            <div class="text-[8.5px] font-bold tracking-[0.32em] uppercase text-white/30 px-3 pt-3 pb-1">On this page</div>
            {homeAnchors.map(link => (
              <a
                href={link.href}
                data-nav-link
                class="mobile-nav-link px-3 py-2.5 rounded-lg text-[12px] font-semibold tracking-[0.14em] uppercase text-white/55 hover:text-white hover:bg-white/[0.05] transition-all duration-200"
              >
                {link.label}
              </a>
            ))}
          </>
        )}
      </div>
    </div>
  </div>
</header>

<!-- Spacer so content doesn't hide under fixed nav -->
<div class="h-16"></div>

<script>
  // ── Theme toggle ──────────────────────────────────────────────────────────
  function isDark() { return document.documentElement.classList.contains('dark'); }

  function syncUI() {
    const dark = isDark();
    document.querySelectorAll<HTMLElement>('.theme-icon-dark').forEach(el => el.classList.toggle('hidden', !dark));
    document.querySelectorAll<HTMLElement>('.theme-icon-light').forEach(el => el.classList.toggle('hidden', dark));
  }

  function toggleTheme() {
    const html = document.documentElement;
    if (isDark()) { html.classList.remove('dark'); localStorage.setItem('theme', 'light'); }
    else          { html.classList.add('dark');    localStorage.setItem('theme', 'dark');  }
    syncUI();
  }

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  syncUI();

  // ── Hamburger menu ────────────────────────────────────────────────────────
  const hamburger     = document.getElementById('nav-hamburger');
  const mobileMenu    = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon     = document.getElementById('close-icon');

  function setMobileMenu(open: boolean) {
    if (!mobileMenu || !hamburger) return;
    if (open) {
      mobileMenu.classList.remove('hidden');
      // Animate open
      mobileMenu.style.maxHeight = '0px';
      mobileMenu.style.opacity = '0';
      requestAnimationFrame(() => requestAnimationFrame(() => {
        mobileMenu.style.transition = 'max-height 320ms cubic-bezier(0.22,1,0.36,1), opacity 260ms ease';
        mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
        mobileMenu.style.opacity = '1';
      }));
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      hamburger.setAttribute('aria-expanded', 'true');
    } else {
      mobileMenu.style.transition = 'max-height 240ms ease, opacity 180ms ease';
      mobileMenu.style.maxHeight = '0px';
      mobileMenu.style.opacity = '0';
      setTimeout(() => {
        mobileMenu.classList.add('hidden');
        mobileMenu.style.transition = '';
        mobileMenu.style.maxHeight = '';
        mobileMenu.style.opacity = '';
      }, 250);
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      hamburger.setAttribute('aria-expanded', 'false');
    }
  }

  hamburger?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('hidden') === false;
    setMobileMenu(!isOpen);
  });

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => setMobileMenu(false));
  });

  // ── Scrolled section dropdown ────────────────────────────────────────────
  const sectionDropdown = document.getElementById('section-dropdown');
  const sectionToggle = document.getElementById('section-menu-toggle');
  const sectionMenu = document.getElementById('section-menu');
  const topSectionLinks = document.getElementById('top-section-links');
  const sectionDropdownMedia = window.matchMedia('(min-width: 768px)');
  let sectionOpenTimer: number | undefined;

  function setSectionMenu(open: boolean) {
    if (!sectionToggle || !sectionMenu) return;
    sectionToggle.setAttribute('aria-expanded', String(open));
    sectionMenu.setAttribute('aria-hidden', String(!open));
    sectionMenu.toggleAttribute('inert', !open);
  }

  sectionToggle?.addEventListener('click', () => {
    window.clearTimeout(sectionOpenTimer);
    setSectionMenu(sectionToggle.getAttribute('aria-expanded') !== 'true');
  });
  sectionMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => setSectionMenu(false));
  });
  document.addEventListener('click', event => {
    if (sectionDropdown && !sectionDropdown.contains(event.target as Node)) setSectionMenu(false);
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && sectionToggle?.getAttribute('aria-expanded') === 'true') {
      setSectionMenu(false);
      sectionToggle.focus();
    }
  });
  sectionDropdownMedia.addEventListener('change', event => {
    window.clearTimeout(sectionOpenTimer);
    setSectionMenu(event.matches && document.getElementById('top-nav')?.classList.contains('nav-scrolled') === true);
  });

  // ── Scroll spy (homepage anchor links) ───────────────────────────────────
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

  if (navLinks.length > 0) {
    // Collect IDs referenced by nav links (works for both section and div targets).
    const targetIds = Array.from(navLinks)
      .map(l => (l.getAttribute('href') || '').split('#')[1])
      .filter(Boolean);

    function updateScrollSpy() {
      const threshold = window.innerHeight * 0.45;
      let activeId = '';
      let bestTop = -Infinity;
      targetIds.forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        const top = el.getBoundingClientRect().top;
        if (top <= threshold && top > bestTop) { bestTop = top; activeId = id; }
      });
      navLinks.forEach(link => {
        const href = link.getAttribute('href') || '';
        const active = activeId !== '' && href.endsWith(`#${activeId}`);
        link.classList.toggle('text-white/85', active);
        link.classList.toggle('bg-white/[0.05]', active);
        link.classList.toggle('text-white/40', !active);
      });
    }

    window.addEventListener('scroll', updateScrollSpy, { passive: true });
    updateScrollSpy();
  }

  // ── Scroll shadow on nav ──────────────────────────────────────────────────
  const header = document.getElementById('top-nav');
  function onScroll() {
    const scrolled = window.scrollY > 8;
    const wasScrolled = header?.classList.contains('nav-scrolled') ?? false;
    header?.classList.toggle('nav-scrolled', scrolled);
    document.documentElement.classList.toggle('nav-scrolled', scrolled);
    topSectionLinks?.toggleAttribute('inert', scrolled);
    topSectionLinks?.setAttribute('aria-hidden', String(scrolled));
    if (scrolled !== wasScrolled) {
      window.clearTimeout(sectionOpenTimer);
      if (scrolled && sectionDropdownMedia.matches) {
        // Open the list as the horizontal links finish moving into the trigger.
        sectionOpenTimer = window.setTimeout(() => {
          if (header?.classList.contains('nav-scrolled')) setSectionMenu(true);
        }, 280);
      } else {
        setSectionMenu(false);
      }
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  #top-nav {
    top: 0;
    left: 50%;
    width: 100%;
    max-width: 100vw;
    transform: translateX(-50%);
    transition: top 320ms ease, width 320ms ease, max-width 320ms ease;
  }
  #top-nav.nav-scrolled {
    top: 12px;
    width: calc(100% - 32px);
    max-width: 1080px;
  }
  #top-nav .nav-glass {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(22px) saturate(140%);
    -webkit-backdrop-filter: blur(22px) saturate(140%);
    transition: background-color 300ms ease, border-color 300ms ease, border-radius 320ms ease, box-shadow 300ms ease;
  }
  #top-nav.nav-scrolled .nav-glass {
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    background-color: rgba(10, 10, 10, 0.84);
    box-shadow: 0 14px 38px rgba(0, 0, 0, 0.38), 0 1px 0 rgba(255, 255, 255, 0.06) inset;
  }
  #top-nav .top-section-links {
    max-width: 360px;
    overflow: hidden;
    white-space: nowrap;
    opacity: 1;
    transform: translateX(0);
    transition: max-width 380ms cubic-bezier(0.22, 1, 0.36, 1), margin-right 380ms cubic-bezier(0.22, 1, 0.36, 1), transform 380ms cubic-bezier(0.22, 1, 0.36, 1), opacity 260ms ease;
  }
  #top-nav .top-section-links a {
    flex-shrink: 0;
  }
  #top-nav.nav-scrolled .top-section-links {
    max-width: 0;
    margin-right: 0;
    opacity: 0;
    transform: translateX(20px);
    pointer-events: none;
  }
  #top-nav .section-dropdown {
    display: none;
    width: 0;
    margin-left: -8px;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-20px) scale(0.94);
    transform-origin: right center;
    pointer-events: none;
    transition: width 380ms cubic-bezier(0.22, 1, 0.36, 1), margin-left 380ms cubic-bezier(0.22, 1, 0.36, 1), transform 380ms cubic-bezier(0.22, 1, 0.36, 1), opacity 280ms ease, visibility 0s linear 380ms;
  }
  #top-nav #section-menu-toggle {
    width: 100%;
    min-width: 0;
    justify-content: center;
    overflow: hidden;
    white-space: nowrap;
  }
  @media (min-width: 768px) {
    #top-nav .section-dropdown {
      display: block;
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    #top-nav .section-dropdown {
      width: 116px;
      margin-left: 0;
      opacity: 1;
      visibility: visible;
      transform: none;
      pointer-events: auto;
    }
  }
  #top-nav.nav-scrolled .section-dropdown {
    width: 116px;
    margin-left: 0;
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
    transition: width 380ms cubic-bezier(0.22, 1, 0.36, 1), margin-left 380ms cubic-bezier(0.22, 1, 0.36, 1), transform 380ms cubic-bezier(0.22, 1, 0.36, 1), opacity 280ms ease, visibility 0s;
  }
  #top-nav #section-menu-toggle[aria-expanded="true"] .section-chevron {
    transform: rotate(180deg);
  }
  #top-nav #section-menu {
    opacity: 0;
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transform: translateY(-10px);
    pointer-events: none;
    transition: clip-path 320ms cubic-bezier(0.22, 1, 0.36, 1), transform 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 220ms ease, visibility 0s linear 320ms;
  }
  #top-nav #section-menu-toggle[aria-expanded="true"] + #section-menu {
    opacity: 1;
    visibility: visible;
    clip-path: inset(0 0 0 0);
    transform: translateY(0);
    pointer-events: auto;
    transition: clip-path 320ms cubic-bezier(0.22, 1, 0.36, 1), transform 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 220ms ease, visibility 0s;
  }
  #top-nav #section-menu .section-menu-link {
    color: rgba(255, 255, 255, 0.72);
    opacity: 0;
    transform: translateY(-8px);
    transition: color 200ms ease, background-color 200ms ease, opacity 240ms ease, transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  #top-nav #section-menu-toggle[aria-expanded="true"] + #section-menu .section-menu-link {
    opacity: 1;
    transform: translateY(0);
  }
  #top-nav #section-menu-toggle[aria-expanded="true"] + #section-menu .section-menu-link:nth-child(2) { transition-delay: 35ms; }
  #top-nav #section-menu-toggle[aria-expanded="true"] + #section-menu .section-menu-link:nth-child(3) { transition-delay: 70ms; }
  #top-nav #section-menu-toggle[aria-expanded="true"] + #section-menu .section-menu-link:nth-child(4) { transition-delay: 105ms; }
  #top-nav #section-menu .section-menu-link:hover,
  #top-nav #section-menu .section-menu-link.text-white\/85 {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }
  #top-nav #mobile-menu {
    width: 100%;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(22px) saturate(140%);
    -webkit-backdrop-filter: blur(22px) saturate(140%);
  }
  #top-nav.nav-scrolled #mobile-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(300px, calc(100vw - 20px));
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 20px;
    background: #0a0a0a;
    box-shadow: 0 14px 38px rgba(0, 0, 0, 0.38);
  }
  #top-nav .mobile-nav-current {
    color: #ffb08d;
    background: linear-gradient(90deg, rgba(255, 77, 77, 0.14), rgba(255, 184, 77, 0.07));
    border-color: rgba(255, 77, 77, 0.28);
  }
  #top-nav #mobile-menu a[data-nav-link] {
    color: rgba(255, 255, 255, 0.72) !important;
  }
  #top-nav #mobile-menu a[data-nav-link].text-white\/85 {
    color: #fff !important;
  }
  :global(html:not(.dark)) #top-nav .nav-glass {
    background-color: rgba(235, 228, 215, 0.88);
    border-bottom-color: rgba(0, 0, 0, 0.10);
  }
  :global(html:not(.dark)) #top-nav.nav-scrolled .nav-glass {
    background-color: rgba(245, 240, 232, 0.94);
    border-color: rgba(45, 36, 28, 0.24);
    box-shadow: 0 14px 38px rgba(68, 48, 28, 0.22);
  }
  :global(html:not(.dark)) #top-nav #section-menu {
    background: #f5f0e8;
    border-color: rgba(45, 36, 28, 0.18);
    box-shadow: 0 14px 38px rgba(68, 48, 28, 0.22);
  }
  :global(html:not(.dark)) #top-nav #section-menu .section-menu-link {
    color: rgba(26, 21, 18, 0.74);
  }
  :global(html:not(.dark)) #top-nav #section-menu .section-menu-link:hover,
  :global(html:not(.dark)) #top-nav #section-menu .section-menu-link.text-white\/85 {
    color: #1a1512;
    background: rgba(26, 21, 18, 0.07);
  }
  :global(html:not(.dark)) #top-nav #mobile-menu {
    background: rgba(235, 228, 215, 0.96);
    border-top-color: rgba(0, 0, 0, 0.10);
  }
  :global(html:not(.dark)) #top-nav.nav-scrolled #mobile-menu {
    background: #f5f0e8;
    border-color: rgba(45, 36, 28, 0.18);
    box-shadow: 0 14px 38px rgba(68, 48, 28, 0.22);
  }
  :global(html:not(.dark)) #top-nav #mobile-menu a[data-nav-link] {
    color: rgba(26, 21, 18, 0.74) !important;
  }
  :global(html:not(.dark)) #top-nav #mobile-menu a[data-nav-link].text-white\/85 {
    color: #1a1512 !important;
  }
  :global(html:not(.dark)) #top-nav .mobile-nav-current {
    color: #99342c;
    background: rgba(230, 57, 70, 0.09);
    border-color: rgba(230, 57, 70, 0.26);
  }
  @media (max-width: 639px) {
    #top-nav.nav-scrolled {
      top: 10px;
      width: calc(100% - 20px);
    }
  }
  @media (min-width: 768px) and (max-width: 820px) {
    #top-nav.nav-scrolled .brand-tagline {
      display: none;
    }
  }
