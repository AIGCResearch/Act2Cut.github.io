---
import QualitativeGallery from './QualitativeGallery.astro';
import AblationSection from './AblationSection.astro';
import DataCollectionCard from '../components/DataCollectionCard.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const methodCards = [
  {
    abbr: 'GLoS-RoPE',
    title: 'Global-Local Shot RoPE',
    desc: `Decouples temporal position encoding across shot boundaries. Global tokens carry sequence-level context while local tokens remain precisely positioned within their own shot — enabling cross-shot coherence without RoPE bleed between unrelated frames.`
  },
  {
    abbr: 'TBR',
    title: 'Transitional Boundary Residual',
    desc: `Enhances spatial and kinetic consistency at the edit point between adjacent shots. Ensures the terminal frame of shot <em>n</em> and the initial frame of shot <em>n+1</em> maintain rigorous 3D spatial alignment and smooth momentum continuity, preventing visual "popping" at hard cuts.`
  },
  {
    abbr: 'SCM',
    title: 'Shot Causal Mask',
    desc: `Applies a unidirectional causal constraint in self-attention so that shot <em>x<sub>i</sub></em> can attend to the history of <em>x<sub>i−1</sub></em>, but not vice versa. Prevents "semantic leakage" where future shot compositions contaminate earlier frames.`
  },
  {
    abbr: 'HCM',
    title: 'Hierarchical Context Mask',
    desc: `Partitions cross-attention into global, relational, and local windows. Global tokens act as universal anchors; per-shot cinematic language remains independently modulated, ensuring precise control over "what happens" vs. "how it is framed" for each shot.`
  },
];
---

<section id="overview" class="space-y-12">

  <!-- Section header -->
  <div data-reveal class="ambient-scrim">
    <span class="act-marker">ACT Ⅱ</span>
    <h2 class="text-3xl font-semibold tracking-tight flex items-center gap-3 mt-1 section-heading-float">
      <span class="inline-block w-1 h-7 bg-gradient-to-b from-[#ff4d4d] to-[#ffb84d] rounded-sm" style="transform: skewX(-6deg);"></span>
      Model Architecture
    </h2>
    <p class="text-white/50 text-sm mt-2 section-heading-float">Architecture overview and core components.</p>
  </div>

  <!-- Architecture diagram — Mac vibrancy glass frame with PNG image. -->
  <figure class="glass-arch rounded-3xl overflow-hidden shadow-2xl relative" style="transition-delay:150ms;" data-reveal>
    <!-- Inner sheen highlight (top-left to bottom-right subtle gradient) -->
    <div class="absolute inset-0 pointer-events-none z-10"
         style="background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, transparent 40%, transparent 70%, rgba(255,255,255,0.06) 100%);"></div>
    <div class="relative w-full overflow-hidden" style="aspect-ratio: 1615 / 862;">
      <div class="absolute inset-4 sm:inset-6">
        <img
          src={`${base}/images/architecture.avif`}
          alt="Act2Cut architecture: GLoS-RoPE, Transitional Boundary Residual, Shot Causal Mask and Hierarchical Context Mask working together for continuous multi-shot video generation."
          class="block w-full h-full object-contain"
          width="1615"
          height="862"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
    <figcaption class="absolute bottom-3 left-4 right-4 flex items-end justify-between gap-3 text-[10px] sm:text-[11px] pointer-events-none z-20">
      <span class="px-2 py-0.5 rounded-md bg-white/20 border border-white/35 backdrop-blur-sm tracking-[0.18em] uppercase font-semibold text-white/90">Architecture</span>
      <a
        href={`${base}/images/architecture.pdf`}
        target="_blank"
        rel="noopener"
        class="pointer-events-auto hidden sm:inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-white/20 border border-white/35 backdrop-blur-sm italic font-light text-white/80 hover:text-[#ffb84d] hover:border-[#ffb84d]/50 transition-colors"
      >
        Fig. 3 — Act2Cut framework overview
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5h5v5M19 5l-9 9M5 19h7"/></svg>
      </a>
    </figcaption>
  </figure>

  <div class="film-strip-divider"></div>

  <!-- Method cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    {methodCards.map((card, i) => (
      <div
        class="glass-card rounded-3xl p-6 md:p-8 border border-white/[0.12] shadow-lg hover:border-[#ff4d4d]/35 transition-all duration-300 chroma-hover"
        data-reveal
        style={`transition-delay:${i * 100}ms`}
      >
        <span class="text-[10px] font-bold tracking-[0.28em] uppercase text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d] block mb-2">{card.abbr}</span>
        <h3 class="text-xl font-semibold mb-3 text-white">{card.title}</h3>
        <p class="text-sm text-white/70 leading-relaxed font-light" set:html={card.desc}></p>
      </div>
    ))}
  </div>
  
  <!-- Dataset curation chapter -->
  <div id="dataset-curation" data-reveal class="ambient-scrim scroll-mt-20">
    <span class="act-marker">DATASET</span>
    <h2 class="text-3xl font-semibold tracking-tight flex items-center gap-3 mt-1 section-heading-float">
      <span class="inline-block w-1 h-7 bg-gradient-to-b from-[#ff4d4d] to-[#ffb84d] rounded-sm" style="transform: skewX(-6deg);"></span>
      Dataset Curation
    </h2>
    <p class="text-white/50 text-sm mt-2 section-heading-float">ActCutVid-1M collection, segmentation, annotation, and quality processing.</p>
  </div>

  <DataCollectionCard/>

  <div class="film-strip-divider"></div>

  <!-- Qualitative results — glass gallery, no baseline -->
  <div id="results" class="scroll-mt-20 space-y-8">
    <div data-reveal class="ambient-scrim">
      <span class="act-marker">ACT Ⅲ</span>
      <h2 class="text-3xl font-semibold tracking-tight flex items-center gap-3 mt-1 section-heading-float">
        <span class="inline-block w-1 h-7 bg-gradient-to-b from-[#ff4d4d] to-[#ffb84d] rounded-sm" style="transform: skewX(-6deg);"></span>
        Experimental Results
      </h2>
      <p class="text-white/50 text-sm mt-2 section-heading-float">Generated sequences across text, image, storyboard, and video inputs.</p>
    </div>
    <QualitativeGallery instanceId="overview" />
  </div>

  <div class="film-strip-divider"></div>

  <!-- Ablation study -->
  <AblationSection />

</section>
