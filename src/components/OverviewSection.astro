---
import QualitativeGallery from './QualitativeGallery.astro';
import AblationSection from './AblationSection.astro';
import DataCollectionCard from '../components/DataCollectionCard.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const methodCards = [
  {
    abbr: 'GLoS-RoPE',
    title: 'Global-Local Shot RoPE',
    desc: `Splits time information into three parts: frame order across the video (global), progress within each shot (local), and shot identity. At a cut, the overall time keeps moving, while the within-shot progress starts again for the new shot.`,
  },
  {
    abbr: 'TBR',
    title: 'Transitional Boundary Residual',
    desc: `Adds a small attention step at each cut. It sends information from the last frame of the previous shot to the first frame of the next shot. A boundary loss helps keep the transition stable.`,
  },
  {
    abbr: 'SCM',
    title: 'Shot Causal Mask',
    desc: `Frames in one shot can attend to each other. Across shots, each shot can use past shots, but past shots cannot see future shots. This keeps future content from leaking backward.`,
  },
  {
    abbr: 'HCM',
    title: 'Hierarchical Context Mask',
    desc: `Controls which text each shot can use. Global descriptions stay active for all shots. Shot-specific camera and framing text stays in its own shot, and relation text only affects the shots it connects. This separates what happens, how shots connect, and how each shot looks.`,
  },
];
---

<section id="overview" class="space-y-12">

  <!-- Dataset curation chapter -->
  <div id="dataset-curation" data-reveal class="ambient-scrim scroll-mt-24">
    <div class="hero-content-divider mb-2" aria-hidden="true"></div>
    <span class="act-marker">Section 2</span>
    <h2 class="text-3xl font-semibold tracking-tight flex items-center gap-3 mt-1 section-heading-float">
      <span class="inline-block w-1 h-7 bg-gradient-to-b from-[#ff4d4d] to-[#ffb84d] rounded-sm" style="transform: skewX(-6deg);"></span>
      Dataset Curation
    </h2>
    <p class="text-white/50 text-base sm:text-lg mt-2 section-heading-float">ActCutVid-1M collection, segmentation, annotation, and quality processing.</p>
  </div>

  <DataCollectionCard/>

  <!-- Section header -->
  <div id="model-architecture" data-reveal class="ambient-scrim scroll-mt-24">
    <div class="hero-content-divider mb-2" aria-hidden="true"></div>
    <span class="act-marker">Section 3</span>
    <h2 class="text-3xl font-semibold tracking-tight flex items-center gap-3 mt-1 section-heading-float">
      <span class="inline-block w-1 h-7 bg-gradient-to-b from-[#ff4d4d] to-[#ffb84d] rounded-sm" style="transform: skewX(-6deg);"></span>
      Model Architecture
    </h2>
    <p class="text-white/50 text-base sm:text-lg mt-2 section-heading-float">Overview of Act2Cut architecture and core components.</p>
  </div>

  <!-- Architecture diagram — Mac vibrancy glass frame with PNG image. -->
  <figure class="glass-arch rounded-3xl overflow-hidden shadow-2xl relative" style="transition-delay:150ms;" data-reveal>
    <!-- Inner sheen highlight (top-left to bottom-right subtle gradient) -->
    <div class="absolute inset-0 pointer-events-none z-10"
         style="background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, transparent 40%, transparent 70%, rgba(255,255,255,0.06) 100%);"></div>
    <div class="relative w-full overflow-hidden" style="aspect-ratio: 1615 / 862;">
      <div class="absolute inset-4 sm:inset-6">
        <img
          src={`${base}/images/architecture.avif`}
          alt="Act2Cut architecture: GLoS-RoPE, Transitional Boundary Residual, Shot Causal Mask and Hierarchical Context Mask working together for continuous multi-shot video generation."
          class="block w-full h-full object-contain"
          width="1615"
          height="862"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
    <figcaption class="relative flex justify-center px-4 pb-3 text-xs">
      <a
        href={`${base}/images/architecture.pdf`}
        target="_blank"
        rel="noopener"
        class="inline-flex min-h-8 items-center justify-center gap-1.5 rounded-full border border-white/35 bg-white/20 px-3 py-1.5 text-center font-medium text-white/90 backdrop-blur-sm transition-colors hover:border-[#ffb84d]/50 hover:text-[#ffb84d] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ffb84d]"
      >
        Fig. 3 — Act2Cut framework overview
        <svg class="h-3 w-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5h5v5M19 5l-9 9M5 19h7"/></svg>
      </a>
    </figcaption>
  </figure>

  <!-- Method cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    {methodCards.map((card, i) => (
      <div
        class="method-component-card glass-card rounded-3xl p-6 md:p-8 border border-white/[0.12] shadow-lg transition-all duration-300 chroma-hover"
        data-reveal
        style={`transition-delay:${i * 100}ms`}
      >
        <span class="text-[10px] font-bold tracking-[0.28em] uppercase text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d] block mb-2">{card.abbr}</span>
        <h3 class="text-xl font-semibold mb-3 text-white">{card.title}</h3>
        <p class="text-sm text-white/70 leading-relaxed font-light" set:html={card.desc}></p>
      </div>
    ))}
  </div>
  
  <!-- Qualitative results — glass gallery, no baseline -->
  <div id="results" class="scroll-mt-20 space-y-8">
    <div data-reveal class="ambient-scrim">
      <div class="hero-content-divider mb-2" aria-hidden="true"></div>
      <span class="act-marker">Section 4</span>
      <h2 class="text-3xl font-semibold tracking-tight flex items-center gap-3 mt-1 section-heading-float">
        <span class="inline-block w-1 h-7 bg-gradient-to-b from-[#ff4d4d] to-[#ffb84d] rounded-sm" style="transform: skewX(-6deg);"></span>
        Experimental Results
      </h2>
      <p class="text-white/50 text-base sm:text-lg mt-2 section-heading-float">Qualitative Inference, Ablation and Quantitative Evaluation</p>
    </div>
    <QualitativeGallery instanceId="overview" />

  <!-- Ablation study -->
    <AblationSection />
    <slot />
  </div>

</section>
