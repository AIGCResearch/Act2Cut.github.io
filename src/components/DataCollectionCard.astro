---
// ActCutVid-1M — featured on the home page.
// Right pane shows an actual visual demo of hierarchical prompting,
// not a screenshot.

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const layers = [
  { tag: 'Global Setting',       dot: '#ff4d4d', body: 'Soft, warm sunlight filters through large windows of a quiet apartment.', sub: 'Env · Scene · Style' },
  { tag: 'Global Action',        dot: '#ff7a3d', body: '[Character 1] is tying up her hair, then turns slightly toward [Character 2].', sub: 'Subject behaviour · Motion' },
  { tag: 'Local Cinematography', dot: '#ffa14d', body: 'Shot 1: Medium Close-Up.   Shot 2: Over-the-Shoulder.', sub: 'Static / Dynamic Cinematography' },
  { tag: 'Focus of Attention (FoA)', dot: '#ffad4d', body: 'Shot 1: The hand of Character1. Shot 2: The face of Character2.', sub: 'Per-shot focus' },
  { tag: 'Transition',           dot: '#ffb84d', body: 'Hard Cut、Shot Reverse Shot、Action Match、Action-Reaction',                                       sub: 'Edit-point relation' },
];
---

<section class="glass-card rounded-2xl sm:rounded-3xl p-6 sm:p-8 md:p-10 border border-white/[0.12] shadow-2xl" data-reveal>

  <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-8 md:gap-10 items-stretch">

    <!-- LEFT: copy -->
    <div class="space-y-5 sm:space-y-6 flex flex-col">
      <div>
        <span class="text-[10px] font-bold tracking-[0.32em] uppercase text-white/40 block mb-2">Dataset · ActCutVid-1M</span>
        <h3 class="text-xl sm:text-2xl font-semibold tracking-tight">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d]">ActCutVid-1M</span>
        </h3>
      </div>

      <ul class="space-y-3 sm:space-y-3.5 text-[13px] sm:text-sm text-white/70 font-light">
        <li class="flex items-start gap-3">
          <span class="mt-0.5 inline-flex w-5 h-5 rounded-md bg-[#ffb84d]/15 border border-[#ffb84d]/30 items-center justify-center shrink-0">
            <svg class="w-3 h-3 text-[#ffb84d]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          </span>
          <span>
            <strong class="text-white/90">Data Collection and Preprocessing:</strong>
            Sourced from films, TV series, and AI-generated content (Sora2, Seedance2.0).
            We pair <strong class="text-white">TransNetV2</strong> with our novel
            <strong class="text-white">Similarity Clustering Boundary Optimizer (SCBO)</strong>
            via CLIP/DINO to precisely calibrate shot boundaries.
          </span>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 inline-flex w-5 h-5 rounded-md bg-[#ffb84d]/15 border border-[#ffb84d]/30 items-center justify-center shrink-0">
            <svg class="w-3 h-3 text-[#ffb84d]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          </span>
          <span><strong class="text-white/90">Continuous Action Detection:</strong> Gemini-3-Pro scores action continuity on a 0–4 Likert scale, distinguishing Strong Action-Cut (4) from Weak Action-Cut (1–3).</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 inline-flex w-5 h-5 rounded-md bg-[#ffb84d]/15 border border-[#ffb84d]/30 items-center justify-center shrink-0">
            <svg class="w-3 h-3 text-[#ffb84d]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          </span>
          <span><strong class="text-white/90">Hierarchical Annotations:</strong> decoupled cinematographic shot-language across Global Setting · Global Action · Local Cinematography · Focus of Attention (FoA) · Transition layers.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 inline-flex w-5 h-5 rounded-md bg-[#ffb84d]/15 border border-[#ffb84d]/30 items-center justify-center shrink-0">
            <svg class="w-3 h-3 text-[#ffb84d]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          </span>
          <span><strong class="text-white/90">Human-in-the-Loop Check:</strong> Experts review action continuity, annotation accuracy, and clip quality.</span>
        </li>
      </ul>

      <div class="mt-auto pt-2">
        <a href={`${base}/dataset`} class="group inline-flex min-h-11 items-center justify-center gap-2.5 rounded-full bg-gradient-to-r from-[#ff7a3d] to-[#ffb84d] px-5 py-3 text-xs font-bold tracking-[0.14em] uppercase text-[#20140f] shadow-[0_6px_22px_rgba(255,122,61,0.24)] transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_10px_28px_rgba(255,122,61,0.38)] active:translate-y-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ffb84d] focus-visible:ring-offset-2 focus-visible:ring-offset-[#181411]">
          Explore the dataset
          <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- RIGHT: hierarchical prompting visual demo -->
    <div class="relative rounded-2xl border border-white/[0.08] bg-white/[0.05] overflow-hidden p-4 sm:p-5">
      <!-- Glass sheen -->
      <div class="absolute inset-0 pointer-events-none opacity-60 mix-blend-overlay"
           style="background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, transparent 35%, transparent 70%, rgba(255,255,255,0.04) 100%);"></div>
      <!-- Light leak -->
      <div class="absolute -top-8 -right-8 w-40 h-40 rounded-full pointer-events-none"
           style="background: radial-gradient(circle, rgba(255,184,77,0.10) 0%, transparent 70%); mix-blend-mode: screen;"></div>

      <div class="relative">
        <div class="flex items-center justify-between mb-3 sm:mb-4">
          <span class="text-[9px] font-bold tracking-[0.28em] uppercase text-white/35">Hierarchical Prompting</span>
          <span class="font-mono text-[8.5px] tracking-[0.18em] text-white/25 uppercase">S1 → S2</span>
        </div>

        <!-- Two-shot strip -->
        <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 sm:gap-3 mb-4 sm:mb-5">
          <!-- Shot 1 -->
          <div class="relative rounded-lg overflow-hidden border border-white/10 bg-black/50 aspect-[16/10]">
            <!-- viewfinder corners -->
            <span class="absolute top-1.5 left-1.5 w-3 h-3 border-t border-l border-white/25 rounded-tl pointer-events-none"></span>
            <span class="absolute top-1.5 right-1.5 w-3 h-3 border-t border-r border-white/25 rounded-tr pointer-events-none"></span>
            <span class="absolute bottom-5 left-1.5 w-3 h-3 border-b border-l border-white/25 rounded-bl pointer-events-none"></span>
            <span class="absolute bottom-5 right-1.5 w-3 h-3 border-b border-r border-white/25 rounded-br pointer-events-none"></span>
            <div class="absolute top-1.5 left-1.5 px-1.5 py-px rounded font-mono text-[7.5px] tracking-[0.18em] uppercase text-white/55 bg-black/40 border border-white/10">S1 · MCU</div>
            <img src={`${base}/images/first.png`} alt="S1 frame" class="absolute inset-0 h-full w-full object-cover" />
            <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/60 to-transparent"></div>
          </div>

          <!-- Cut indicator -->
          <div class="flex flex-col items-center gap-1">
            <div class="w-px h-4 bg-gradient-to-b from-transparent to-[#ff4d4d]"></div>
            <div class="px-1.5 py-0.5 rounded font-mono text-[7.5px] tracking-[0.22em] uppercase font-bold text-[#ff4d4d] border border-[#ff4d4d]/40 bg-[#ff4d4d]/10 leading-none">Cut</div>
            <div class="w-px h-4 bg-gradient-to-t from-transparent to-[#ff4d4d]"></div>
          </div>

          <!-- Shot 2 -->
          <div class="relative rounded-lg overflow-hidden border border-white/10 bg-black/50 aspect-[16/10]">
            <!-- viewfinder corners -->
            <span class="absolute top-1.5 left-1.5 w-3 h-3 border-t border-l border-white/25 rounded-tl pointer-events-none"></span>
            <span class="absolute top-1.5 right-1.5 w-3 h-3 border-t border-r border-white/25 rounded-tr pointer-events-none"></span>
            <span class="absolute bottom-5 left-1.5 w-3 h-3 border-b border-l border-white/25 rounded-bl pointer-events-none"></span>
            <span class="absolute bottom-5 right-1.5 w-3 h-3 border-b border-r border-white/25 rounded-br pointer-events-none"></span>
            <div class="absolute top-1.5 left-1.5 px-1.5 py-px rounded font-mono text-[7.5px] tracking-[0.18em] uppercase text-white/55 bg-black/40 border border-white/10">S2 · OTS</div>
            <img src={`${base}/images/second.png`} alt="S2 frame" class="absolute inset-0 h-full w-full object-cover" />
            <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/60 to-transparent"></div>
          </div>
        </div>

        <!-- Caption layer stack -->
        <ul class="space-y-1.5">
          {layers.map((layer, i) => (
            <li
              class="layer-row group relative rounded-lg border border-white/[0.06] bg-white/[0.02] hover:bg-white/[0.04] hover:border-white/[0.12] transition-all duration-300 px-2.5 py-2 flex items-start gap-2.5"
              style={`transition-delay:${i * 60}ms`}
            >
              <span
                class="mt-1 w-2 h-2 rounded-full shrink-0 shadow-[0_0_10px_currentColor]"
                style={`background:${layer.dot};color:${layer.dot}`}
              ></span>
              <div class="flex-1 min-w-0">
                <div class="flex items-baseline justify-between gap-2">
                  <span class="font-mono text-[9px] tracking-[0.22em] uppercase font-bold text-white/85">{layer.tag}</span>
                  <span class="text-[8.5px] tracking-[0.12em] uppercase text-white/30 truncate">{layer.sub}</span>
                </div>
                <p class="font-mono text-[10.5px] sm:text-[11px] leading-snug text-white/55 mt-0.5 line-clamp-2">{layer.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>

  </div>
</section>
