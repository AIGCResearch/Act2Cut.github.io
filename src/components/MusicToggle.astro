---
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<button
  id="music-toggle"
  type="button"
  aria-label="Background music"
  aria-pressed="false"
  title="Turn background music on"
  class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-white/[0.1] bg-white/[0.04] text-white/55 transition-colors duration-200 hover:text-white/85 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#ffb84d]"
>
  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M11 5 6 9H3v6h3l5 4V5Z" />
    <path class="music-on" d="M15.5 8.5a5 5 0 0 1 0 7m3-10a9 9 0 0 1 0 13" />
    <path class="music-off" d="m16 9 6 6m0-6-6 6" />
  </svg>
</button>
<audio id="background-music" src={`${base}/audio/act2cut-theme.mp3`} preload="auto" loop aria-hidden="true"></audio>

<style>
  button[aria-pressed='true'] {
    color: #ffb84d;
  }
  :global(html:not(.dark)) button[aria-pressed='true'] {
    color: #96551c;
  }
  :global(html:not(.dark)) button[aria-pressed='false'] {
    color: #655247;
  }
  button[aria-pressed='true'] .music-off,
  button[aria-pressed='false'] .music-on {
    display: none;
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#music-toggle');
  const audio = document.querySelector<HTMLAudioElement>('#background-music');
  if (toggle && audio) {
    let enabled = true;
    let fadeFrame = 0;

    const update = () => {
      const playing = !audio.paused;
      toggle.setAttribute('aria-pressed', String(playing));
      toggle.title = playing ? 'Turn background music off' : 'Turn background music on';
    };
    const tryPlay = async () => {
      if (!enabled || !audio.paused) return;
      cancelAnimationFrame(fadeFrame);
      audio.volume = 0;
      try {
        await audio.play();
      } catch {
        return;
      }
      if (!enabled || audio.paused || audio.volume !== 0) return;

      const started = performance.now();
      const targetVolume = 0.48;
      const fadeIn = (now: number) => {
        if (audio.paused) return;
        audio.volume = targetVolume * Math.min(1, (now - started) / 1400);
        if (audio.volume < targetVolume) fadeFrame = requestAnimationFrame(fadeIn);
      };
      fadeFrame = requestAnimationFrame(fadeIn);
    };

    toggle.addEventListener('click', () => {
      enabled = audio.paused;
      if (enabled) void tryPlay();
      else {
        cancelAnimationFrame(fadeFrame);
        audio.pause();
      }
      update();
    });

    audio.addEventListener('play', update);
    audio.addEventListener('pause', update);
    const startAfterGesture = (event: Event) => {
      if (!enabled || !audio.paused) return;
      if (event.target instanceof Element && event.target.closest('#music-toggle')) return;
      void tryPlay();
    };
    // Match AIGC Research: retry during the gesture, before the click or scroll settles.
    document.addEventListener('pointerdown', startAfterGesture, { capture: true });
    document.addEventListener('touchstart', startAfterGesture, { capture: true, passive: true });
    document.addEventListener('keydown', startAfterGesture, { capture: true });
    document.addEventListener('click', startAfterGesture, { capture: true });
    let scrollAttempted = false;
    const retryOnScroll = () => {
      if (!enabled || !audio.paused) return;
      // Start on the first real wheel or touch scroll on both desktop and mobile.
      if (scrollAttempted) return;
      scrollAttempted = true;
      void tryPlay();
    };
    window.addEventListener('wheel', retryOnScroll, { passive: true });
    window.addEventListener('touchmove', retryOnScroll, { passive: true });
    window.addEventListener('scroll', retryOnScroll, { passive: true });
    update();
    void tryPlay();
  }
</script>
