<script is:inline>
(function () {
  var charts = [];

  // ── Shared dataset builder ──────────────────────────────────────────────────
  function makeDatasets(rawSets) {
    return rawSets.map(function (s) {
      var isClosed = s.type === 'closed';
      var isOurs   = s.type === 'ours';
      var hex = s.color;
      // Convert hex to rgba for fills
      var r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
      return {
        label:                s.label,
        data:                 s.data,
        borderColor:          hex,
        backgroundColor:      isOurs ? 'rgba('+r+','+g+','+b+',0.15)'
                                     : 'rgba('+r+','+g+','+b+',0.05)',
        borderWidth:          isOurs ? 2.5 : 1.5,
        borderDash:           isClosed ? [5, 4] : [],
        pointBackgroundColor: hex,
        pointBorderColor:     hex,
        pointRadius:          isOurs ? 4 : 2.5,
        pointStyle:           isClosed ? 'rect' : (isOurs ? 'star' : 'circle'),
      };
    });
  }

  function getRadarTheme() {
    var isDark = document.documentElement.classList.contains('dark');
    return {
      gridColor: isDark ? 'rgba(255,255,255,0.07)' : 'rgba(15,23,42,0.12)',
      pointLabelColor: isDark ? 'rgba(255,255,255,0.65)' : 'rgba(15,23,42,0.72)',
      legendColor: isDark ? 'rgba(255,255,255,0.72)' : 'rgba(15,23,42,0.76)',
    };
  }

  // ── Chart factory ──────────────────────────────────────────────────────────
  function buildRadar(canvasId, labels, rawSets) {
    var canvas = document.getElementById(canvasId);
    if (!canvas) return;
    var theme = getRadarTheme();
    var chart = new Chart(canvas.getContext('2d'), {
      type: 'radar',
      data: { labels: labels, datasets: makeDatasets(rawSets) },
      options: {
        responsive: true,
        scales: {
          r: {
            min: 0, max: 100,
            ticks: { display: false, stepSize: 25 },
            grid:       { color: theme.gridColor },
            angleLines: { color: theme.gridColor },
            pointLabels: {
              color: theme.pointLabelColor,
              font:  { size: 9 },
            },
          }
        },
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              color:           theme.legendColor,
              padding:         14,
              usePointStyle:   true,
              pointStyleWidth: 10,
              font: { size: 10 },
            }
          },
          tooltip: {
            callbacks: {
              label: function(ctx) {
                return ' ' + ctx.dataset.label + ': ' + ctx.parsed.r;
              }
            }
          }
        }
      }
    });
    charts.push(chart);
  }

  // ── Data ──────────────────────────────────────────────────────────────────
  // Content: 13 dims — NC(Env,Sce,Sty,CS,CA/OM) | VC(Env,Sce,Sty,CS) | AC(CA/OM) | SA(SCC,SCA) | Aes
  // Range-normalized per column across all 8 non-ablation rows: worst→30, best→100
  var contentLabels = ['NC.Env','NC.Sce','NC.Sty','NC.CS','NC.CA/OM','VC.Env','VC.Sce','VC.Sty','VC.CS','AC.CA/OM','SA.SCC','SA.SCA','Aes'];
  var contentSets = [
    { label:'Happyhorse-1.0',       type:'closed', color:'#ff6b6b', data:[40.000,100.000,100.000,80.000,41.667,30.000,30.000,58.824,67.895,92.057,87.400,57.401,100.000] },
    { label:'Seedance-2.0',         type:'closed', color:'#ffa94d', data:[70.000,56.923,70.000,72.500,59.167,88.187,77.335,97.255,84.211,85.720,93.700,64.539,77.537] },
    { label:'Kling3',               type:'closed', color:'#ffd43b', data:[60.000,46.154,30.000,60.000,70.833,63.469,65.000,95.882,62.105,85.720,30.000,30.000,83.060] },
    { label:'Sora2',                type:'closed', color:'#b197fc', data:[100.000,56.923,55.000,100.000,100.000,100.000,100.000,83.529,100.000,85.929,83.200,61.316,30.000] },
    { label:'HoloCine',             type:'open',   color:'#38d9a9', data:[70.000,83.846,80.000,60.000,82.500,70.688,73.172,83.529,35.263,74.624,100.000,100.000,71.940] },
    { label:'MultiShotMaster-1.3B', type:'open',   color:'#74c0fc', data:[30.000,40.769,35.000,30.000,30.000,53.188,56.828,30.000,30.000,30.000,78.300,78.355,52.612] },
    { label:'MultiShotMaster-14B',  type:'open',   color:'#a9e34b', data:[90.000,30.000,70.000,57.500,38.750,82.500,85.507,31.373,38.947,71.054,93.000,94.474,49.776] },
    { label:'★ Act2Cut (Ours)',     type:'ours',   color:'#ff4d4d', data:[50.000,62.308,70.000,67.500,94.167,79.438,65.000,100.000,90.000,100.000,97.200,98.849,81.194] },
  ];

  // Cinematography: 14 dims — SC(SS,LT,FF,FV,AE,AA,AD,DoF) | DC(CM,CZ,CR) | RC(ST,Cont,Narr)
  var cinemLabels = ['SC.SS','SC.LT','SC.FF','SC.FV','SC.AE','SC.AA','SC.AD','SC.DoF','DC.CM','DC.CZ','DC.CR','RC.ST','RC.Cont','RC.Narr'];
  var cinemSets = [
    { label:'Happyhorse-1.0',       type:'closed', color:'#ff6b6b', data:[100.000,84.559,82.807,100.000,74.000,74.925,82.239,73.750,100.000,100.000,86.419,86.452,71.040,34.430] },
    { label:'Seedance-2.0',         type:'closed', color:'#ffa94d', data:[93.000,100.000,100.000,82.807,80.000,82.239,100.000,78.611,87.011,97.079,84.325,83.629,91.726,100.000] },
    { label:'Kling3',               type:'closed', color:'#ffd43b', data:[87.000,77.353,75.439,76.667,85.000,96.866,77.015,68.889,98.211,96.971,100.000,74.032,71.868,69.873] },
    { label:'Sora2',                type:'closed', color:'#b197fc', data:[93.000,91.765,91.404,91.404,100.000,100.000,89.552,100.000,77.367,98.269,76.455,100.000,64.752,78.734] },
    { label:'HoloCine',             type:'open',   color:'#38d9a9', data:[91.000,91.765,84.035,90.175,47.000,47.761,54.030,47.500,94.789,89.830,86.355,85.323,47.045,56.582] },
    { label:'MultiShotMaster-1.3B', type:'open',   color:'#74c0fc', data:[30.000,30.000,30.000,30.000,30.000,30.000,37.313,30.000,30.000,30.000,30.000,58.226,30.000,30.000] },
    { label:'MultiShotMaster-14B',  type:'open',   color:'#a9e34b', data:[90.000,90.735,87.719,87.719,86.000,95.821,30.000,44.583,72.311,84.853,72.330,30.000,37.943,77.848] },
    { label:'★ Act2Cut (Ours)',     type:'ours',   color:'#ff4d4d', data:[92.000,89.706,91.404,85.263,87.000,93.731,90.597,72.778,84.444,85.286,88.577,99.435,100.000,99.114] },
  ];

  // ── Init ──────────────────────────────────────────────────────────────────
  function destroyCharts() {
    charts.forEach(function (chart) { chart.destroy(); });
    charts = [];
  }

  function init() {
    destroyCharts();
    buildRadar('radarContent', contentLabels, contentSets);
    buildRadar('radarCinem',   cinemLabels,   cinemSets);
  }

  function load() {
    if (window.Chart) { init(); return; }
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js';
    s.onload = init;
    document.head.appendChild(s);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', load);
  } else {
    load();
  }

  new MutationObserver(function (mutations) {
    if (!window.Chart) return;
    for (var i = 0; i < mutations.length; i += 1) {
      if (mutations[i].attributeName === 'class') {
        init();
        break;
      }
    }
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
})();
</script>
