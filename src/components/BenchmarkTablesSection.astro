function rowBg(style: string) {
  if (style === 'ours')    return 'border-b border-white/[0.05] bg-[#ff4d4d]/[0.08] hover:bg-[#ff4d4d]/[0.12] transition-colors';
  if (style === 'ablation') return 'border-b border-white/[0.05] hover:bg-white/[0.04] transition-colors';
  return 'border-b border-white/[0.05] hover:bg-white/[0.04] transition-colors';
}

