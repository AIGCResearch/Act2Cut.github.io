<script is:inline>
(function () {
  // ── Shared dataset builder ──────────────────────────────────────────────────
  function makeDatasets(rawSets) {
    return rawSets.map(function (s) {
      var isClosed = s.type === 'closed';
      var isOurs   = s.type === 'ours';
      var hex = s.color;
      // Convert hex to rgba for fills
      var r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
      return {
        label:                s.label,
        data:                 s.data,
        borderColor:          hex,
        backgroundColor:      isOurs ? 'rgba('+r+','+g+','+b+',0.15)'
                                     : 'rgba('+r+','+g+','+b+',0.05)',
        borderWidth:          isOurs ? 2.5 : 1.5,
        borderDash:           isClosed ? [5, 4] : [],
        pointBackgroundColor: hex,
        pointBorderColor:     hex,
        pointRadius:          isOurs ? 4 : 2.5,
        pointStyle:           isClosed ? 'rect' : (isOurs ? 'star' : 'circle'),
      };
    });
  }

  // ── Chart factory ──────────────────────────────────────────────────────────
  function buildRadar(canvasId, labels, rawSets) {
    var canvas = document.getElementById(canvasId);
    if (!canvas) return;
    new Chart(canvas.getContext('2d'), {
      type: 'radar',
      data: { labels: labels, datasets: makeDatasets(rawSets) },
      options: {
        responsive: true,
        scales: {
          r: {
            min: 0, max: 100,
            ticks: { display: false, stepSize: 25 },
            grid:       { color: 'rgba(255,255,255,0.07)' },
            angleLines: { color: 'rgba(255,255,255,0.07)' },
            pointLabels: {
              color: 'rgba(255,255,255,0.65)',
              font:  { size: 11 },
            },
          }
        },
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              color:           'rgba(255,255,255,0.72)',
              padding:         14,
              usePointStyle:   true,
              pointStyleWidth: 10,
              font: { size: 10 },
            }
          },
          tooltip: {
            callbacks: {
              label: function(ctx) {
                return ' ' + ctx.dataset.label + ': ' + ctx.parsed.r;
              }
            }
          }
        }
      }
    });
  }

  // ── Data ──────────────────────────────────────────────────────────────────
  var contentLabels = ['Char. VC', 'Style VC', 'Action Cont.', 'Shot Align.', 'Aesthetics'];
  var contentSets = [
    { label:'Happyhorse-1.0',       type:'closed', color:'#ff6b6b', data:[51, 59, 57, 68,100] },
    { label:'Seedance-2.0',         type:'closed', color:'#ffa94d', data:[48, 97, 88, 84, 78] },
    { label:'Kling3',               type:'closed', color:'#ffd43b', data:[66, 96, 95, 30, 83] },
    { label:'Sora2',                type:'closed', color:'#b197fc', data:[52, 84, 88, 82, 30] },
    { label:'HoloCine',             type:'open',   color:'#38d9a9', data:[100, 84, 73,100, 72] },
    { label:'MultiShotMaster-1.3B', type:'open',   color:'#74c0fc', data:[59, 31, 77, 75, 50] },
    { label:'MultiShotMaster-14B',  type:'open',   color:'#a9e34b', data:[62, 30, 30, 73, 53] },
    { label:'★ Act2Cut (Ours)',     type:'ours',   color:'#ff4d4d', data:[30,100,100, 73, 81] },
  ];

  var cinemLabels = ['RC: Spatio-Temp.', 'RC: Continuity', 'RC: Narrativity', 'DC: Cam. Move', 'DC: Cam. Rotate', 'Static Cine'];
  var cinemSets = [
    { label:'Happyhorse-1.0',       type:'closed', color:'#ff6b6b', data:[86, 30, 48,100, 93, 44] },
    { label:'Seedance-2.0',         type:'closed', color:'#ffa94d', data:[72, 88,100, 30, 30, 56] },
    { label:'Kling3',               type:'closed', color:'#ffd43b', data:[100, 53, 77, 98,100, 30] },
    { label:'Sora2',                type:'closed', color:'#b197fc', data:[100, 53, 83, 30, 80,100] },
    { label:'HoloCine',             type:'open',   color:'#38d9a9', data:[86, 77, 65, 96, 93, 69] },
    { label:'MultiShotMaster-1.3B', type:'open',   color:'#74c0fc', data:[58, 77, 30, 30, 30, 50] },
    { label:'MultiShotMaster-14B',  type:'open',   color:'#a9e34b', data:[30, 30, 83, 90, 90, 80] },
    { label:'★ Act2Cut (Ours)',     type:'ours',   color:'#ff4d4d', data:[100,100,100, 96, 85, 68] },
  ];

  // ── Init ──────────────────────────────────────────────────────────────────
  function init() {
    buildRadar('radarContent', contentLabels, contentSets);
    buildRadar('radarCinem',   cinemLabels,   cinemSets);
  }

  function load() {
    if (window.Chart) { init(); return; }
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js';
    s.onload = init;
    document.head.appendChild(s);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', load);
  } else {
    load();
  }
})();
</script>
