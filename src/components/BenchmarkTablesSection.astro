---

<section id="dataset-benchmark-results" class="space-y-10 sm:space-y-12">

  <!-- Section header -->
  <div data-reveal class="ambient-scrim">
    <span class="act-marker">ACT Ⅳ</span>
    <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight flex items-center gap-3 mt-1 section-heading-float">
      <span class="inline-block w-1 h-6 sm:h-7 bg-gradient-to-b from-[#ff4d4d] to-[#ffb84d] rounded-sm" style="transform: skewX(-6deg);"></span>
      Benchmark Results
    </h2>
    <p class="text-white/50 text-[13px] sm:text-sm mt-2 section-heading-float">ActCutBench evaluation across global content and cinematography. <span class="text-[#ffb84d]">★</span> = Act2Cut (Ours).</p>
    <div class="flex items-center gap-3 pt-3 text-[10px] text-white/40 flex-wrap">
      <span class="text-white/35 mr-1">Rank badges:</span>
      <span class="rank-cell rank-1 text-[10px]" style="min-width:0;padding:1px 6px;">1st</span>
      <span class="rank-cell rank-2 text-[10px]" style="min-width:0;padding:1px 6px;">2nd</span>
      <span class="rank-cell rank-3 text-[10px]" style="min-width:0;padding:1px 6px;">3rd</span>
      <span class="rank-cell rank-4 text-[10px]" style="min-width:0;padding:1px 6px;">4th</span>
      <span class="rank-cell rank-5 text-[10px]" style="min-width:0;padding:1px 6px;">5th</span>
      <span class="mx-1 text-white/20">|</span>
      <span class="text-white/35 mr-1">Radar lines:</span>
      <span class="flex items-center gap-1"><span style="display:inline-block;width:18px;height:2px;background:rgba(255,255,255,0.4);border-top:2px dashed rgba(255,255,255,0.5);margin-top:1px"></span><span>Closed-source</span></span>
      <span class="flex items-center gap-1"><span style="display:inline-block;width:18px;height:2px;background:rgba(255,255,255,0.5)"></span><span>Open-source</span></span>
      <span class="flex items-center gap-1"><span style="display:inline-block;width:18px;height:2.5px;background:#ff4d4d"></span><span class="text-[#ff7070]">Act2Cut (Ours)</span></span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════
       TABLE 1 — Global Content Sub-Bench
       ═══════════════════════════════════════════════════════════════════ -->
  <div class="glass-table-card rounded-2xl sm:rounded-3xl border border-white/10 shadow-2xl overflow-hidden" data-reveal style="transition-delay:80ms">
    <div class="p-5 sm:p-8 border-b border-white/10">
      <span class="inline-block text-[9px] font-bold tracking-[0.32em] uppercase text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d4d] to-[#ffb84d] border border-[#ff4d4d]/30 px-2.5 py-1 mb-3">ActCutBench — Global Content Sub-Bench</span>
      <p class="text-sm text-white/60 leading-relaxed max-w-3xl">
        <strong class="text-white/80">NC</strong> Narrative Consistency (<em>Env</em>, <em>Sce</em>, <em>Sty</em>, <em>CS</em>, <em>CA/OM</em>).
        <strong class="text-white/80">VC</strong> Visual Coherence (<em>Env</em>, <em>Sce</em>, <em>Sty</em>, <em>CS</em>).
        <strong class="text-white/80">AC</strong> Action Continuity.
        <strong class="text-white/80">SA</strong> Shot Alignment (<em>SCC</em>, <em>SCA</em>).
        <strong class="text-white/80">Aes</strong> Aesthetics. All ↑ higher is better.
      </p>
    </div>
    <div class="overflow-x-auto thin-scroll">
      <table class="w-full text-left border-collapse text-xs whitespace-nowrap">
        <thead>
          <tr class="text-white/40 border-b border-white/10">
            <th class="px-4 py-3 font-normal text-left" rowspan="2">Method</th>
            <th class="px-4 py-3 font-normal text-left" rowspan="2">Base Model Ver.</th>
            <th class="px-3 py-2 text-center text-[9px] tracking-widest text-[#ffb84d]/80 border-b border-[#ffb84d]/20 bg-[#ff4d4d]/5" colspan="5">NC ↑</th>
            <th class="px-3 py-2 text-center text-[9px] tracking-widest text-[#ffb84d]/80 border-b border-[#ffb84d]/20 bg-[#ff4d4d]/5" colspan="4">VC ↑</th>
            <th class="px-3 py-2 text-center text-[9px] tracking-widest text-[#ffb84d]/80 border-b border-[#ffb84d]/20 bg-[#ff4d4d]/5" colspan="1">AC ↑</th>
            <th class="px-3 py-2 text-center text-[9px] tracking-widest text-[#ffb84d]/80 border-b border-[#ffb84d]/20 bg-[#ff4d4d]/5" colspan="2">SA ↑</th>
            <th class="px-3 py-3 text-center font-normal" rowspan="2">Aes ↑</th>
          </tr>
          <tr class="text-white/30 border-b border-white/10 text-center">
            <th class="px-2 py-2 font-normal">Env</th><th class="px-2 py-2 font-normal">Sce</th><th class="px-2 py-2 font-normal">Sty</th><th class="px-2 py-2 font-normal">CS</th><th class="px-2 py-2 font-normal">CA/OM</th>
            <th class="px-2 py-2 font-normal">Env</th><th class="px-2 py-2 font-normal">Sce</th><th class="px-2 py-2 font-normal">Sty</th><th class="px-2 py-2 font-normal">CS</th>
            <th class="px-2 py-2 font-normal">CA/OM</th>
            <th class="px-2 py-2 font-normal">SCC</th><th class="px-2 py-2 font-normal">SCA</th>
          </tr>
        </thead>
        <tbody class="text-white/60 font-mono">
          <tr class="border-b border-white/[0.07]">
            <td class="px-4 py-2 text-[9px] tracking-widest text-white/30 uppercase font-semibold italic" colspan="15">Results on ActCutBench</td>
          </tr>
          <!-- Closed-Source -->
          <tr class="border-b border-white/[0.04] bg-[#ff6b6b]/[0.04]">
            <td class="px-4 py-1.5 text-[9px] tracking-wider text-[#ff9999]/60 font-semibold" colspan="15">Closed-Source</td>
          </tr>
          {contentRows.filter(r => r.style === 'closed').map(row => (
            <tr class={rowBg(row.style)}>
              <td class="px-4 py-3 font-sans">{row.method}</td>
              <td class="px-4 py-3 font-sans text-white/30 text-[11px]">{row.base}</td>
              {row.cells.slice(0,12).map(([val, rank]) => (
                <td class="px-2 py-3 text-center">{rank > 0 ? <span class={`rank-cell rank-${rank}`}>{val}</span> : val}</td>
              ))}
              <td class="px-3 py-3 text-center">{row.cells[12][1] > 0 ? <span class={`rank-cell rank-${row.cells[12][1]}`}>{row.cells[12][0]}</span> : row.cells[12][0]}</td>
            </tr>
          ))}
          <!-- Open-Source -->
          <tr class="border-b border-white/[0.04] bg-[#38d9a9]/[0.04]">
            <td class="px-4 py-1.5 text-[9px] tracking-wider text-[#38d9a9]/60 font-semibold" colspan="15">Open-Source</td>
          </tr>
          {contentRows.filter(r => r.style === 'open').map(row => (
            <tr class={rowBg(row.style)}>
              <td class="px-4 py-3 font-sans">{row.method}</td>
              <td class="px-4 py-3 font-sans text-white/30 text-[11px]">{row.base}</td>
              {row.cells.slice(0,12).map(([val, rank]) => (
                <td class="px-2 py-3 text-center">{rank > 0 ? <span class={`rank-cell rank-${rank}`}>{val}</span> : val}</td>
              ))}
              <td class="px-3 py-3 text-center">{row.cells[12][1] > 0 ? <span class={`rank-cell rank-${row.cells[12][1]}`}>{row.cells[12][0]}</span> : row.cells[12][0]}</td>
            </tr>
          ))}
          <!-- Act2Cut -->
          {contentRows.filter(r => r.style === 'ours').map(row => (
            <tr class="border-y border-[#ff4d4d]/20 bg-[#ff4d4d]/[0.08] hover:bg-[#ff4d4d]/[0.13] transition-colors">
              <td class="px-4 py-3 font-sans font-bold text-white border-l-2 border-[#ff4d4d]">{row.method} <span class="text-white/45 font-normal text-[11px]">(Ours)</span></td>
              <td class="px-4 py-3 font-sans text-white/50 text-[11px]">{row.base}</td>
              {row.cells.slice(0,12).map(([val, rank]) => (
                <td class="px-2 py-3 text-center text-[#ffb84d]">{rank > 0 ? <span class={`rank-cell rank-${rank}`}>{val}</span> : val}</td>
              ))}
              <td class="px-3 py-3 text-center text-[#ffb84d]">{row.cells[12][1] > 0 ? <span class={`rank-cell rank-${row.cells[12][1]}`}>{row.cells[12][0]}</span> : row.cells[12][0]}</td>
            </tr>
          ))}
          <!-- Ablation -->
          <tr class="border-b border-white/[0.04] bg-[#74c0fc]/[0.03]">
            <td class="px-4 py-1.5 text-[9px] tracking-wider text-[#74c0fc]/50 font-semibold" colspan="15">Ablation Study</td>
          </tr>
          {contentRows.filter(r => r.style === 'ablation').map(row => (
            <tr class={rowBg(row.style)}>
              <td class="px-4 py-3 font-sans text-white/55">{row.method}</td>
              <td class="px-4 py-3 font-sans text-white/25 text-[11px]">{row.base}</td>
              {row.cells.slice(0,12).map(([val]) => <td class="px-2 py-3 text-center text-white/25">{val}</td>)}
              <td class="px-3 py-3 text-center text-white/25">{row.cells[12][0]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Radar chart for Global Content -->
    <div class="border-t border-white/[0.06] p-5 sm:p-8">
