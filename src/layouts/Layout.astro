---
import '../styles/global.css';
import outfitLatin from '../assets/fonts/outfit-latin-wght-normal.woff2?url';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<!doctype html>
<html lang="en" class="dark scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Act2Cut: Continuous Multi-Shot Video Narrative Match on Action-Cut" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/+$/, '')}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" as="font" type="font/woff2" href={outfitLatin} crossorigin="anonymous" />
    <title>{title}</title>
    <!-- Anti-FOUC: apply saved theme before first paint. Default = dark; only switch to light if explicitly set. -->
    <script is:inline>
      (function() {
        var saved = localStorage.getItem('theme');
        if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen text-white font-sans antialiased bg-black overflow-x-hidden">

    <!-- Fixed background layer -->
    <div id="site-background" class="fixed inset-0 -z-50 pointer-events-none overflow-hidden">
      <img
        src={`${base}/images/waterfall_collage.avif`}
        class="parallax-bg site-bg-image absolute inset-x-0 top-0 w-full opacity-75 mix-blend-screen"
        style="will-change: transform;"
        alt=""
      />
      <div class="site-bg-soften absolute inset-0" aria-hidden="true"></div>
    </div>

    <!-- Global vignette -->
    <div
      class="theme-vignette fixed inset-0 pointer-events-none z-0"
      style="background: radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,0.7) 100%);"
    ></div>

    <slot />

    <!-- Scroll reveal observer -->
    <script>
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('[data-reveal]').forEach(el => revealObserver.observe(el));
    </script>

    <!-- Draw dense particle fields on canvas so independent motion does not create thousands of DOM layers. -->
    <script>
      const sparkColors = ['255,184,77', '255,122,61', '255,77,77', '255,235,190'];
      const randomBetween = (min: number, max: number) => min + Math.random() * (max - min);
      type Spark = { x: number; y: number; vx: number; vy: number; size: number; alpha: number; color: string; phase: number; side?: number };
      const makeSpark = (mode: 'divider' | 'nav', width: number, height: number): Spark => {
        const color = `rgba(${sparkColors[Math.floor(Math.random() * sparkColors.length)]}, ${randomBetween(0.45, 0.95).toFixed(2)})`;
        if (mode === 'divider') {
          return {
            x: randomBetween(0, width), y: randomBetween(-2, 3),
            vx: randomBetween(-5, 5), vy: randomBetween(8, 26),
            size: randomBetween(0.3, 0.8), alpha: randomBetween(0.55, 1), color, phase: Math.random() * Math.PI * 2,
          };
        }
        const side = Math.floor(Math.random() * 4);
        const spark: Spark = {
          x: randomBetween(0, width), y: randomBetween(0, height), vx: 0, vy: 0,
          size: randomBetween(0.3, 0.8), alpha: randomBetween(0.55, 1), color, phase: Math.random() * Math.PI * 2, side,
        };
        if (side === 0) { spark.x = randomBetween(0, width * 0.08); spark.vx = randomBetween(8, 32); spark.vy = randomBetween(-4, 4); }
        if (side === 1) { spark.x = randomBetween(width * 0.92, width); spark.vx = randomBetween(-32, -8); spark.vy = randomBetween(-4, 4); }
        if (side === 2) { spark.y = randomBetween(0, height * 0.08); spark.vx = randomBetween(-5, 5); spark.vy = randomBetween(8, 28); }
        if (side === 3) { spark.y = randomBetween(height * 0.92, height); spark.vx = randomBetween(-5, 5); spark.vy = randomBetween(-28, -8); }
        return spark;
      };

      const initSparkCanvas = (container: HTMLElement, count: number, mode: 'divider' | 'nav') => {
        const canvas = document.createElement('canvas');
        canvas.className = mode === 'divider' ? 'divider-spark-canvas' : 'nav-spark-canvas';
        canvas.setAttribute('aria-hidden', 'true');
        container.appendChild(canvas);
        const ctx = canvas.getContext('2d');
        if (!ctx) return { setActive: (_active: boolean) => {} };
        let width = 1;
        let height = mode === 'divider' ? 44 : 1;
        let scale = 1;
        let particles: Spark[] = [];
        let active = false;
        let raf: number | null = null;
        let last = performance.now();
        const resize = () => {
          const rect = container.getBoundingClientRect();
          width = Math.max(1, rect.width);
          height = mode === 'divider' ? 44 : Math.max(1, rect.height - 4);
          scale = Math.min(2, window.devicePixelRatio || 1);
          canvas.width = Math.round(width * scale);
          canvas.height = Math.round(height * scale);
          particles = Array.from({ length: count }, () => makeSpark(mode, width, height));
          ctx.setTransform(scale, 0, 0, scale, 0, 0);
        };
        const frame = (now: number) => {
          if (!active) { raf = null; return; }
          const dt = Math.min(0.04, (now - last) / 1000);
          last = now;
          ctx.clearRect(0, 0, width, height);
          particles.forEach((p) => {
            p.phase += dt * 0.35;
            p.x += p.vx * dt;
            p.y += p.vy * dt;
            if (mode === 'divider' && p.y > height + 2) Object.assign(p, makeSpark(mode, width, height));
            if (mode === 'nav' && (p.x < -4 || p.x > width + 4 || p.y < -4 || p.y > height + 4)) Object.assign(p, makeSpark(mode, width, height));
            const shimmer = 0.55 + Math.sin(p.phase) * 0.35;
            ctx.globalAlpha = p.alpha * shimmer;
            ctx.fillStyle = p.color;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx.fill();
          });
          ctx.globalAlpha = 1;
          raf = requestAnimationFrame(frame);
        };
        const setActive = (next: boolean) => {
          active = next;
          if (active && raf === null) { last = performance.now(); raf = requestAnimationFrame(frame); }
        };
        resize();
        new ResizeObserver(resize).observe(container);
        return { setActive };
      };

      document.querySelectorAll<HTMLElement>('.hero-content-divider').forEach((divider) => {
        const glowDuration = randomBetween(3.2, 5.8);
        divider.style.setProperty('--divider-glow-duration', `${glowDuration.toFixed(2)}s`);
        divider.style.setProperty('--divider-glow-delay', `${(-Math.random() * glowDuration).toFixed(2)}s`);
        divider.classList.add('has-spark-canvas');
        const sparkCanvas = initSparkCanvas(divider, 600, 'divider');
        new IntersectionObserver((entries) => sparkCanvas.setActive(entries[0]?.isIntersecting ?? false), { rootMargin: '120px 0px' }).observe(divider);
      });

      document.querySelectorAll<HTMLElement>('#top-nav .nav-glass').forEach((navGlass) => {
        navGlass.classList.add('has-spark-canvas');
        const sparkCanvas = initSparkCanvas(navGlass, 800, 'nav');
        const sync = () => sparkCanvas.setActive(document.getElementById('top-nav')?.classList.contains('nav-scrolled') ?? false);
        new MutationObserver(sync).observe(document.getElementById('top-nav')!, { attributes: true, attributeFilter: ['class'] });
        sync();
      });
    </script>

    <!-- Keep the floating team mark tucked away at the top of the page. -->
    <script>
      const teamFooter = document.querySelector<HTMLElement>('.hero-team-footer');
      if (teamFooter) {
        const desktopMode = window.matchMedia('(hover: hover) and (pointer: fine)');
        const syncTeamFooter = () => {
          const scrolled = window.scrollY > 8;
          teamFooter.classList.toggle('team-footer-scrolled', scrolled);
          if (!scrolled) {
            teamFooter.classList.remove('team-footer-returning', 'team-footer-touch-active');
          }
        };
        teamFooter.addEventListener('pointerenter', event => {
          if (event.pointerType !== 'mouse' || !desktopMode.matches) return;
          teamFooter.classList.remove('team-footer-returning');
        });
        teamFooter.addEventListener('pointerleave', event => {
          if (event.pointerType !== 'mouse' || !desktopMode.matches) return;
          if (teamFooter.classList.contains('team-footer-scrolled')) {
            teamFooter.classList.remove('team-footer-returning');
            void teamFooter.offsetWidth;
            teamFooter.classList.add('team-footer-returning');
          }
        });
        teamFooter.addEventListener('animationend', event => {
          if (event.animationName === 'hero-team-hover-return') teamFooter.classList.remove('team-footer-returning');
        });
        const closeTouchFooter = () => {
          if (!teamFooter.classList.contains('team-footer-touch-active')) return;
          teamFooter.classList.remove('team-footer-touch-active', 'team-footer-returning');
          void teamFooter.offsetWidth;
          teamFooter.classList.add('team-footer-returning');
        };
        teamFooter.addEventListener('click', () => {
          if (desktopMode.matches || !teamFooter.classList.contains('team-footer-scrolled')) return;
          if (teamFooter.classList.contains('team-footer-touch-active')) {
            closeTouchFooter();
          } else {
            teamFooter.classList.remove('team-footer-returning');
            teamFooter.classList.add('team-footer-touch-active');
          }
        });
        document.addEventListener('pointerdown', event => {
          if (!desktopMode.matches && event.target instanceof Node && !teamFooter.contains(event.target)) {
            closeTouchFooter();
          }
        });
        desktopMode.addEventListener('change', () => {
          teamFooter.classList.remove('team-footer-returning', 'team-footer-touch-active');
        });
        window.addEventListener('scroll', syncTeamFooter, { passive: true });
        syncTeamFooter();
      }
    </script>

    <!-- Parallax background.
         JS only writes to the --parallax-y custom property; the actual transform is composed in
         CSS so the mobile centering translateX(-50%) is preserved. Mobile uses a smaller rate
         because the wider 180% image otherwise moves a noticeable distance per scroll pixel. -->
    <script>
      const parallaxBg = document.querySelector<HTMLElement>('.parallax-bg');
      if (parallaxBg) {
        const mq = window.matchMedia('(max-width: 640px)');
        let rate = mq.matches ? 0.035 : 0.08;
        mq.addEventListener?.('change', (e) => { rate = e.matches ? 0.035 : 0.08; });

        let raf: number | null = null;
        window.addEventListener('scroll', () => {
          if (raf !== null) return;
          raf = requestAnimationFrame(() => {
            parallaxBg.style.setProperty('--parallax-y', `-${window.scrollY * rate}px`);
            raf = null;
          });
        }, { passive: true });
      }
    </script>
  </body>
</html>
